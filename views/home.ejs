<%- include('partials/header') %>
<section class="hero">
  <span class="blob p"></span><span class="blob n"></span>
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow"><%- cms('home.hero.eyebrow') %></span>
      <h1 data-split><%- cms('home.hero.title') %></h1>
      <p class="lead"><%- cms('home.hero.text') %></p>
      <div class="actions">
        <a class="btn" href="/rooms" data-magnetic>See available rooms <svg class="arrow"><use href="#i-arrow"/></svg></a>
        <a class="btn ghost" href="/referrals" data-magnetic>Make a referral</a>
      </div>
      <div class="hero-trust">
        <span><svg><use href="#i-shield"/></svg>Safe, inspected homes</span>
        <span><svg><use href="#i-heart"/></svg>Person-centred support</span>
        <span><svg><use href="#i-pin"/></svg>Across Birmingham</span>
      </div>
    </div>
    <div class="hero-art">
      <span class="dots"></span><span class="block"></span>
      <div class="frame" data-parallax="0.06"><%- cmsImg('home.hero.image', 'A warm, welcoming Solace Housing home') %></div>
      <div class="float-card a"><span class="ic"><svg><use href="#i-bed"/></svg></span><div><b><span class="live" style="display:inline-block;margin-right:8px;vertical-align:middle"></span><%= roomCount %> room<%= roomCount === 1 ? '' : 's' %></b><span>available right now</span></div></div>
      <div class="float-card b"><span class="ic" style="background:var(--navy)"><svg><use href="#i-heart"/></svg></span><div><b style="font-size:1rem"><%- cms('home.hero.badge') %></b><span>Birmingham · since day one</span></div></div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="highlights" data-reveal>
    <% [1,2,3,4].forEach(function(n){ %><div class="highlight"><b><%- cms('home.stat'+n+'.value') %></b><span><%- cms('home.stat'+n+'.label') %></span></div><% }) %>
  </div>
</div>

<section class="section">
  <div class="wrap split">
    <div class="media" data-reveal="left">
      <div class="ph"><%- cmsImg('home.intro.image', 'Solace Housing community') %></div>
      <span class="accent"></span>
      <span class="tag"><svg><use href="#i-users"/></svg>A real community</span>
    </div>
    <div data-reveal="right">
      <span class="eyebrow"><%- cms('home.intro.eyebrow') %></span>
      <h2><%- cms('home.intro.title') %></h2>
      <%- cmsRich('home.intro.text', 'rich lead') %>
      <div class="actions" style="margin-top:30px"><a class="btn navy" href="/about">About Solace <svg class="arrow"><use href="#i-arrow"/></svg></a><a class="link-arrow" href="/services">Our services <svg><use href="#i-arrow"/></svg></a></div>
    </div>
  </div>
</section>

<section class="section bg-cream">
  <div class="wrap">
    <div class="sec-head">
      <div data-reveal><span class="eyebrow">Rooms</span><h2><%- cms('home.rooms.title') %></h2><p class="lead"><%- cms('home.rooms.text') %></p></div>
      <a class="btn" href="/rooms" data-reveal>All rooms <svg class="arrow"><use href="#i-arrow"/></svg></a>
    </div>
    <% if (rooms.length) { %>
    <div class="grid g3"><% rooms.slice(0,3).forEach(function(room, i){ %><%- include('partials/room-card', { room, i }) %><% }) %></div>
    <% } else { %><div class="notice info"><svg><use href="#i-bed"/></svg><div><p><%- cms('rooms.empty') %></p></div></div><% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div data-reveal><span class="eyebrow">Services</span><h2><%- cms('home.services.title') %></h2><p class="lead"><%- cms('home.services.text') %></p></div>
      <a class="link-arrow" href="/services" data-reveal>Explore all services <svg><use href="#i-arrow"/></svg></a>
    </div>
    <div class="grid g3">
      <% services.slice(0,6).forEach(function(s, i){ %>
      <a class="svc" href="/services#<%= s.slug %>" style="text-decoration:none;--i:<%= i % 3 %>" data-reveal>
        <span class="ic"><svg><use href="#i-<%= s.icon || 'heart' %>"/></svg></span>
        <span class="aud"><%= s.audience %></span>
        <h3><%= s.title %></h3><p><%= s.summary %></p>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section bg-navy" style="overflow:hidden">
  <div class="wrap">
    <div class="sec-head">
      <div data-reveal><span class="eyebrow">Community</span><h2><%- cms('home.life.title') %></h2><p class="lead" style="color:#b9d2dd"><%- cms('home.life.text') %></p></div>
      <div class="actions" data-reveal><a class="btn" href="/events">Events calendar <svg class="arrow"><use href="#i-arrow"/></svg></a><a class="btn white" href="/stories">Tenants' stories</a></div>
    </div>
    <% if (events.length) { %><div class="grid g3"><% events.forEach(function(ev, i){ %><%- include('partials/event-card', { ev, i }) %><% }) %></div><% } %>
    <% if (stories.length && stories[0].quote) { %>
    <div style="margin-top:90px" data-reveal><p class="big-quote" style="color:#fff"><%= stories[0].quote %></p><p class="center" style="margin-top:20px;color:var(--pink-2);font-family:var(--font-h);font-weight:600"><%= stories[0].person ? stories[0].person + ', ' : '' %><a href="/stories/<%= stories[0].slug %>" style="color:#fff">read the story →</a></p></div>
    <% } %>
  </div>
</section>

<% if (partners.length) { %>
<section class="section tight">
  <div class="wrap"><p class="center eyebrow" style="display:flex;justify-content:center" data-reveal><%- cms('home.partners.title') %></p></div>
  <div class="marquee" data-reveal>
    <div class="marquee-track">
      <% for (let r = 0; r < 2; r++) { partners.forEach(function(p){ %>
        <a class="logo-tile" href="/working-together" <%- r ? 'aria-hidden="true" tabindex="-1"' : '' %>><%- p.logo ? img(p.logo, p.name) : p.name %></a>
      <% }) } %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/cta') %>

<section class="section tight">
  <div class="wrap">
    <% if (news.length) { %>
    <div class="sec-head"><div data-reveal><span class="eyebrow">Latest</span><h2>News & newsletter</h2></div><a class="link-arrow" href="/news" data-reveal>All news <svg><use href="#i-arrow"/></svg></a></div>
    <div class="grid g2" style="margin-bottom:60px">
      <% news.forEach(function(p, i){ %>
      <a class="card spot" href="/news/<%= p.slug %>" data-reveal style="--i:<%= i %>;flex-direction:row">
        <div class="thumb" style="width:42%;aspect-ratio:auto;flex:none"><%- img(p.image, p.title) %></div>
        <div class="body"><span class="badge"><%= p.category %></span><h3><%= p.title %></h3><p><%= p.summary %></p><div class="foot"><span class="muted" style="font-size:.85rem"><%= fmtDate(p.date) %></span><span class="link-arrow">Read <svg><use href="#i-arrow"/></svg></span></div></div>
      </a>
      <% }) %>
    </div>
    <% } %>
    <%- include('partials/newsletter') %>
  </div>
</section>
<%- include('partials/footer') %>
