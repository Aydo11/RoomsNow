<!doctype html>
<html lang="en-GB" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= meta.title ? meta.title + ' | ' + settings.org_name : settings.org_name + ' | Supported Housing in Birmingham' %></title>
<meta name="description" content="<%= meta.description || t('home.hero.text') %>">
<meta property="og:title" content="<%= meta.title || settings.org_name %>">
<meta property="og:description" content="<%= meta.description || t('home.hero.text') %>">
<meta property="og:image" content="<%= meta.image && !/\.svg$/.test(meta.image) ? meta.image : '/img/og.png' %>">
<meta property="og:type" content="website">
<meta name="theme-color" content="#013F58">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css?v=1">
<script>document.documentElement.classList.replace('no-js','js')</script>
</head>
<body class="<%= isAdmin ? 'is-admin' : '' %>">
<%- include('icons') %>
<a class="skip" href="#main">Skip to content</a>
<div class="progress" aria-hidden="true"></div>
<% if (settings.announcement) { %><div class="announce"><%= settings.announcement %><% if (settings.announcement_link) { %> <a href="<%= settings.announcement_link %>">Find out more →</a><% } %></div><% } %>
<header class="site-header">
  <div class="wrap hdr">
    <a href="/" class="logo" aria-label="<%= settings.org_name %> home"><b>solace</b><small>HOUSING</small></a>
    <nav class="nav" aria-label="Main">
      <% NAV.forEach(function(n){ if (n.children) { const act = n.children.some(c => path.startsWith(c.href) && !(n.label === 'Tenants' && c.href === '/events')); %>
        <div class="dd <%= act ? 'active' : '' %>"><button type="button" aria-haspopup="true"><%= n.label %> <svg><use href="#i-down"/></svg></button>
          <div class="dd-menu"><% n.children.forEach(function(c){ %><a href="<%= c.href %>"><%= c.label %></a><% }) %></div></div>
      <% } else { %><a href="<%= n.href %>" class="<%= path.startsWith(n.href) ? 'active' : '' %>"><%= n.label %></a><% } }) %>
    </nav>
    <div class="hdr-cta">
      <a class="btn wa sm" href="/wa?page=<%= encodeURIComponent(path) %>" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg><span>WhatsApp</span></a>
      <a class="btn sm" href="/rooms">View rooms <svg class="arrow"><use href="#i-arrow"/></svg></a>
      <button class="icon-btn menu-toggle" aria-label="Open menu" aria-expanded="false" data-menu-open><svg><use href="#i-menu"/></svg></button>
    </div>
  </div>
</header>
<div class="mnav" id="mnav" aria-hidden="true">
  <button class="icon-btn close" aria-label="Close menu" data-menu-close><svg><use href="#i-close"/></svg></button>
  <% let mi = 0; NAV.forEach(function(n){ if (n.children) { %>
    <div class="group"><%= n.label %></div><div class="sub"><% n.children.forEach(function(c){ %><a href="<%= c.href %>" style="--i:<%= mi++ %>"><%= c.label %></a><% }) %></div>
  <% } else { %><a href="<%= n.href %>" style="--i:<%= mi++ %>"><%= n.label %></a><% } }) %>
  <a class="btn wa" href="/wa?page=menu" target="_blank" rel="noopener" style="--i:<%= mi++ %>"><svg><use href="#i-whatsapp"/></svg><%= t('global.wa.label') %></a>
</div>
<main id="main">
