<% const cover = (room.images || [])[0]; const stCls = room.status === 'Available now' ? 'green' : room.status === 'Under offer' ? 'amber' : 'navy'; %>
<article class="card room-card spot" data-reveal style="--i:<%= typeof i !== 'undefined' ? i % 3 : 0 %>" data-area="<%= room.area %>" data-type="<%= room.room_type %>" data-status="<%= room.status %>">
  <a class="cover-link" href="/rooms/<%= room.slug %><%= typeof src !== 'undefined' && src ? '?src=' + encodeURIComponent(src) : '' %>" aria-label="<%= room.title %>"></a>
  <div class="thumb">
    <div class="badges"><span class="badge dot <%= stCls %>"><%= room.status %></span><% if (room.room_type) { %><span class="badge navy"><%= room.room_type %></span><% } %></div>
    <% if (room.sample) { %><span class="sample-tag">Sample</span><% } %>
    <%- img(cover, room.title) || '<img src="/img/placeholders/bedroom-1.svg" alt="">' %>
    <% if ((room.images || []).length > 1) { %><span class="count-ph"><svg><use href="#i-image"/></svg><%= room.images.length %></span><% } %>
  </div>
  <div class="body">
    <div class="meta-row"><span><svg><use href="#i-pin"/></svg><%= [room.area, room.postcode].filter(Boolean).join(', ') %></span><% if (room.available_from) { %><span><svg><use href="#i-calendar"/></svg><%= room.available_from <= today() ? 'Available now' : 'From ' + fmtDate(room.available_from, 'short') %></span><% } %></div>
    <h3><%= room.title %></h3>
    <p><%= room.summary %></p>
    <div class="foot">
      <span class="price"><%= room.rent %></span>
      <a class="wa-mini" href="<%= waRoom(room, typeof src !== 'undefined' ? src : '') %>" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>Enquire</a>
    </div>
  </div>
</article>
