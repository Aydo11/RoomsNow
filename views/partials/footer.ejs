  <div class="wrap">
    <div class="ft-grid">
      <div>
        <a href="/" class="logo" aria-label="Home"><b>solace</b><small>HOUSING</small></a>
        <p style="margin-top:22px;max-width:320px"><%- cms('global.tagline') %></p>
        <div class="socials">
          <a href="<%= wa() %>" target="_blank" rel="noopener" aria-label="WhatsApp"><svg><use href="#i-whatsapp"/></svg></a>
          <% if (settings.facebook) { %><a href="<%= settings.facebook %>" target="_blank" rel="noopener" aria-label="Facebook"><svg><use href="#i-facebook"/></svg></a><% } %>
          <% if (settings.instagram) { %><a href="<%= settings.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg><use href="#i-instagram"/></svg></a><% } %>
          <% if (settings.tiktok) { %><a href="<%= settings.tiktok %>" target="_blank" rel="noopener" aria-label="TikTok"><svg><use href="#i-tiktok"/></svg></a><% } %>
          <% if (settings.linkedin) { %><a href="<%= settings.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><svg><use href="#i-linkedin"/></svg></a><% } %>
        </div>
      </div>
      <div>
        <h4>Explore</h4>
        <ul><li><a href="/about">About us</a></li><li><a href="/services">Services</a></li><li><a href="/rooms">Rooms available</a></li><li><a href="/referrals">Make a referral</a></li><li><a href="/working-together">Working together</a></li><li><a href="/news">News & newsletter</a></li></ul>
      </div>
      <div>
        <h4>Tenants</h4>
        <ul><li><a href="/repairs">Report a repair</a></li><li><a href="/events">Events calendar</a></li><li><a href="/stories">Tenants' stories</a></li><li><a href="/charter-of-rights">Charter of Rights</a></li><li><a href="/complaints">Complaints</a></li><li><a href="/documents">Downloads</a></li></ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <p><%- nl2br(settings.address) %></p>
        <p><a href="<%= telHref %>"><%= settings.phone %></a><br><a href="mailto:<%= settings.email %>"><%= settings.email %></a></p>
        <a class="btn wa sm" href="/wa?page=footer" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg><%= t('global.wa.label') %></a>
      </div>
    </div>
    <div class="ft-big" aria-hidden="true">solace</div>
    <div class="ft-bottom">
      <span>© <%= year %> <%= settings.company_line %></span>
      <span><a href="/privacy">Privacy</a> · <a href="/contact">Contact</a> · <a href="/admin">Staff login</a></span>
    </div>
  </div>
</footer>
<% if (settings.wa_float === '1') { %>
<a class="wa-float" href="/wa?page=<%= encodeURIComponent(path) %>" target="_blank" rel="noopener" aria-label="<%= t('global.wa.label') %>"><span class="i"><svg><use href="#i-whatsapp"/></svg></span><span class="t"><%= t('global.wa.label') %></span></a>
<% } %>
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="x" aria-label="Close" data-lb-close><svg><use href="#i-close"/></svg></button>
  <button class="prev" aria-label="Previous" data-lb-prev><svg><use href="#i-left"/></svg></button>
  <img alt="">
  <button class="next" aria-label="Next" data-lb-next><svg><use href="#i-right"/></svg></button>
  <div class="cnt"></div>
</div>
<% if (isAdmin) { %>
<div class="admin-bar" id="adminBar">
  <a href="/admin"><svg><use href="#i-home"/></svg>Dashboard</a>
  <button type="button" data-edit-toggle><svg><use href="#i-edit"/></svg>Edit this page</button>
  <% if (editLink) { %><a href="<%= editLink %>"><svg><use href="#i-file"/></svg>Edit in admin</a><% } %>
</div>
<link rel="stylesheet" href="/css/live-edit.css">
<script src="/js/live-edit.js" defer></script>
<% } %>
<script src="/js/site.js" defer></script>
</body>
</html>
