<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'services', crumb: 'Services' }) %>
<section class="section tight">
  <div class="wrap">
    <h2 data-reveal style="margin-bottom:36px"><%- cms('services.audience.title') %></h2>
    <div class="grid g4">
      <% const links = ['/repairs', '/rooms', '/referrals', '/contact']; [1,2,3,4].forEach(function(n){ %>
      <a class="aud-tile" href="<%= links[n-1] %>" data-reveal style="--i:<%= n-1 %>"><span class="n">0<%= n %></span><h3><%- cms('services.aud'+n+'.title') %></h3><p><%- cms('services.aud'+n+'.text') %></p><span class="go"><svg><use href="#i-arrow"/></svg></span></a>
      <% }) %>
    </div>
  </div>
</section>
<section class="section" style="padding-top:40px">
  <div class="wrap">
    <% services.forEach(function(s, i){ %>
    <div class="svc-row" id="<%= s.slug %>" data-reveal>
      <span class="num"><%= String(i+1).padStart(2,'0') %></span>
      <div>
        <span class="eyebrow" style="margin-bottom:10px"><%= s.audience %></span>
        <h2 style="font-size:clamp(1.6rem,2.6vw,2.2rem)"><%= s.title %></h2>
        <p class="lead" style="font-size:1.08rem"><%= s.summary %></p>
        <% if (s.body) { %><div class="rich muted"><%- rich(s.body) %></div><% } %>
      </div>
      <div>
        <% if (s.image) { %><div class="media" style="margin-bottom:24px"><div class="ph" style="aspect-ratio:16/10"><%- img(s.image, s.title) %></div></div><% } %>
        <% if ((s.points || []).length) { %><ul class="checks"><% s.points.forEach(function(p){ %><li><svg><use href="#i-check"/></svg><span><%= p %></span></li><% }) %></ul><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
