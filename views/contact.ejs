<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'contact', crumb: 'Contact', actions: '<a class="btn wa" href="/wa?page=contact" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>' + esc(t('global.wa.label')) + '</a><a class="btn white" href="' + telHref + '"><svg><use href="#i-phone"/></svg>' + esc(settings.phone) + '</a>' }) %>
<section class="section" style="padding-top:60px">
  <div class="wrap contact-grid">
    <div class="info-card" data-reveal="left">
      <h3 style="color:#fff;font-size:1.6rem;margin-bottom:10px">Get in touch</h3>
      <div class="info-row"><span class="ic"><svg><use href="#i-whatsapp"/></svg></span><div><small>WhatsApp (fastest)</small><a href="/wa?page=contact-card" target="_blank" rel="noopener">Start a chat →</a></div></div>
      <div class="info-row"><span class="ic"><svg><use href="#i-phone"/></svg></span><div><small>Telephone</small><a href="<%= telHref %>"><%= settings.phone %></a></div></div>
      <div class="info-row"><span class="ic"><svg><use href="#i-mail"/></svg></span><div><small>Email</small><a href="mailto:<%= settings.email %>"><%= settings.email %></a></div></div>
      <div class="info-row"><span class="ic"><svg><use href="#i-pin"/></svg></span><div><small>Office</small><b><%- nl2br(settings.address) %></b></div></div>
      <div class="info-row"><span class="ic"><svg><use href="#i-clock"/></svg></span><div><small>Opening times</small><b style="font-weight:400;font-family:var(--font-b);color:#cfe2ea"><%- nl2br(settings.hours) %></b></div></div>
    </div>
    <div class="form-card" id="form" data-reveal="right">
      <% if (sent) { %>
        <div class="success"><div class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><h2>Message sent</h2><p class="lead" style="margin:0 auto 12px"><%- cms('contact.success') %></p><span class="refno">Reference #<%= sent %></span></div>
      <% } else { %>
      <h2 style="font-size:1.9rem"><%- cms('contact.form.title') %></h2>
      <% if (query.error) { %><div class="notice danger"><svg><use href="#i-alert"/></svg><div><p>Please add your name, an email or phone number, and a message.</p></div></div><% } %>
      <form method="post" action="/contact" class="fgrid" style="margin-top:20px">
        <label class="hp">Leave empty <input name="website" tabindex="-1" autocomplete="off"></label>
        <div class="field"><label>Your name <em>*</em></label><input name="name" required autocomplete="name"></div>
        <div class="field"><label>I am</label><select name="who"><option>Looking for a room</option><option>A current tenant</option><option>A referral agency / professional</option><option>A partner organisation</option><option>A member of the public</option></select></div>
        <div class="field"><label>Email</label><input type="email" name="email" autocomplete="email"></div>
        <div class="field"><label>Phone</label><input type="tel" name="phone" autocomplete="tel"></div>
        <div class="field full"><label>Subject</label><input name="topic" value="<%= query.room ? 'Room enquiry: ' + query.room : '' %>"></div>
        <div class="field full"><label>Message <em>*</em></label><textarea name="message" required></textarea></div>
        <div class="full" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap"><button class="btn" type="submit">Send message <svg class="arrow"><use href="#i-arrow"/></svg></button><span class="muted" style="font-size:.85rem">See our <a href="/privacy">privacy policy</a>.</span></div>
      </form>
      <% } %>
    </div>
  </div>
</section>
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="map" data-reveal="mask">
      <iframe title="Map showing the Solace Housing office" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=<%= encodeURIComponent(mapQuery) %>&z=15&output=embed"></iframe>
      <div class="pin-card"><b><%= settings.org_name %></b><div class="muted" style="font-size:.9rem"><%= String(settings.address).split('\n').slice(0,3).join(', ') %></div><a class="link-arrow" style="font-size:.9rem;margin-top:6px" target="_blank" rel="noopener" href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(mapQuery) %>">Get directions <svg><use href="#i-arrow"/></svg></a></div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
