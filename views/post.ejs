<%- include('partials/header') %>
<section class="page-hero" style="padding-bottom:120px"><div class="wrap"><div class="hero-inner" style="max-width:860px">
  <nav class="crumbs"><a href="/">Home</a><span>/</span><a href="/news">News</a></nav>
  <span class="badge" style="margin-bottom:16px"><%= p.category %></span>
  <h1 data-split style="font-size:clamp(2.2rem,4.6vw,3.8rem)"><%= p.title %></h1>
  <div class="meta-row" style="color:#cfe2ea"><span><svg><use href="#i-calendar"/></svg><%= fmtDate(p.date) %></span></div>
</div></div></section>
<section class="section" style="padding-top:0"><div class="wrap">
  <% if (p.image) { %><div class="article-hero" style="max-width:1040px;margin:0 auto" data-reveal><%- img(p.image, p.title) %></div><% } %>
  <article class="article">
    <p class="lead" style="max-width:none"><%= p.summary %></p>
    <div class="rich"><%- rich(p.body) %></div>
    <% if (p.attachment) { %><a class="doc" style="margin-top:36px" href="<%= p.attachment.src %>" download="<%= p.attachment.name %>"><span class="ic"><svg><use href="#i-file"/></svg></span><div><h4>Download the newsletter</h4><p><%= p.attachment.name %></p></div><span class="dl"><svg><use href="#i-download"/></svg></span></a><% } %>
    <p style="margin-top:40px"><a class="link-arrow" href="/news"><svg style="transform:rotate(180deg)"><use href="#i-arrow"/></svg> All news</a></p>
  </article>
</div></section>
<section class="section tight"><div class="wrap"><%- include('partials/newsletter') %></div></section>
<%- include('partials/footer') %>
