<%- include('partials/header') %>
<% const ims = (s.images || []).map(parseImg).filter(Boolean); %>
<section class="page-hero" style="padding-bottom:120px">
  <div class="wrap"><div class="hero-inner" style="max-width:860px">
    <nav class="crumbs"><a href="/">Home</a><span>/</span><a href="/stories">Stories</a></nav>
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap"><% if (s.category) { %><span class="badge"><%= s.category %></span><% } %><% if (s.sample) { %><span class="badge grey">Sample story</span><% } %></div>
    <h1 data-split style="font-size:clamp(2.2rem,4.6vw,3.8rem)"><%= s.title %></h1>
    <div class="meta-row" style="color:#cfe2ea"><span><svg><use href="#i-calendar"/></svg><%= fmtDate(s.date) %></span><% if (s.person) { %><span><svg><use href="#i-star"/></svg><%= s.person %></span><% } %><% if (s.related_event) { %><span><svg><use href="#i-users"/></svg><%= s.related_event %></span><% } %></div>
  </div></div>
</section>
<section class="section" style="padding-top:0">
  <div class="wrap">
    <% if (ims[0]) { %><div class="article-hero" style="max-width:1040px;margin:0 auto" data-reveal><%- img(ims[0], s.title) %></div><% } %>
    <article class="article">
      <p class="lead" style="max-width:none" data-reveal><%= s.summary %></p>
      <div class="rich" data-reveal><%- rich(s.body) %></div>
      <% if (s.quote) { %><blockquote class="q" style="margin:40px 0" data-reveal><%= s.quote %></blockquote><% } %>
      <% if (ims.length > 1) { %><div class="mini-gallery" data-gallery><% ims.forEach(function(im, i){ %><button type="button" data-lb="<%= i %>"><%- img(im, s.title) %></button><% }) %><script type="application/json" data-lb-list><%- JSON.stringify(ims.map(i => i.src)) %></script></div><% } %>
      <div class="consent-note"><svg><use href="#i-shield"/></svg><p style="margin:0"><%- cms('stories.consent') %></p></div>
    </article>
  </div>
</section>
<% if (more.length) { %><section class="section bg-cream"><div class="wrap"><h2 data-reveal style="margin-bottom:36px">More stories</h2><div class="grid g3"><% more.forEach(function(x, i){ %><%- include('partials/story-card', { s: x, i }) %><% }) %></div></div></section><% } %>
<%- include('partials/footer') %>
