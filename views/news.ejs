<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'news', crumb: 'News & newsletter' }) %>
<section class="section" style="padding-top:60px">
  <div class="wrap">
    <% if (posts.length) { %>
    <div class="grid g3">
    <% posts.forEach(function(p, i){ %>
      <a class="card spot" href="/news/<%= p.slug %>" data-reveal style="--i:<%= i % 3 %>">
        <div class="thumb"><div class="badges"><span class="badge <%= p.category === 'Newsletter' ? 'navy' : '' %>"><%= p.category %></span></div><% if (p.sample) { %><span class="sample-tag">Sample</span><% } %><%- img(p.image, p.title) || '<img src="/img/placeholders/news.svg" alt="">' %></div>
        <div class="body"><span class="muted" style="font-size:.85rem"><%= fmtDate(p.date) %></span><h3><%= p.title %></h3><p><%= p.summary %></p><div class="foot"><span class="link-arrow">Read <svg><use href="#i-arrow"/></svg></span><% if (p.attachment) { %><span class="badge grey"><svg style="width:14px;height:14px"><use href="#i-download"/></svg>PDF</span><% } %></div></div>
      </a>
    <% }) %>
    </div>
    <% } else { %><div class="notice info"><svg><use href="#i-book"/></svg><div><p>News is coming soon.</p></div></div><% } %>
    <div style="margin-top:80px"><%- include('partials/newsletter') %></div>
  </div>
</section>
<%- include('partials/footer') %>
