<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'about', crumb: 'About us' }) %>
<section class="section">
  <div class="wrap split">
    <div data-reveal="left"><span class="eyebrow">01 · Who we are</span><h2><%- cms('about.who.title') %></h2><%- cmsRich('about.who.text', 'rich lead') %></div>
    <div class="media" data-reveal="right"><div class="ph"><%- cmsImg('about.who.image', 'Solace Housing property') %></div><span class="accent"></span></div>
  </div>
</section>
<section class="section bg-cream">
  <div class="wrap split rev">
    <div data-reveal="right"><span class="eyebrow">02 · What we do</span><h2><%- cms('about.what.title') %></h2><%- cmsRich('about.what.text', 'rich lead') %>
      <div class="actions" style="margin-top:26px"><a class="btn navy" href="/services">See our services <svg class="arrow"><use href="#i-arrow"/></svg></a></div></div>
    <div class="media" data-reveal="left"><div class="ph"><%- cmsImg('about.what.image', 'Keys to a new home') %></div><span class="accent"></span><span class="tag"><svg><use href="#i-key"/></svg>Your new start</span></div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <div class="center" data-reveal style="margin-bottom:56px"><span class="eyebrow">03 · Values</span><h2><%- cms('about.values.title') %></h2></div>
    <div class="grid g4">
      <% [1,2,3,4].forEach(function(n){ %><div class="value" data-reveal style="--i:<%= n-1 %>"><span class="n">0<%= n %></span><h3><%- cms('about.value'+n+'.title') %></h3><p><%- cms('about.value'+n+'.text') %></p></div><% }) %>
    </div>
  </div>
</section>
<section class="section bg-mist">
  <div class="wrap">
    <div class="center" data-reveal style="margin-bottom:64px"><span class="eyebrow">04 · Our approach</span><h2><%- cms('about.approach.title') %></h2><p class="lead"><%- cms('about.approach.text') %></p></div>
    <div class="approach">
      <% [1,2,3,4].forEach(function(n){ %><div data-reveal style="--i:<%= n-1 %>"><span class="dot"><%= n %></span><h3><%- cms('about.step'+n+'.title') %></h3><p><%- cms('about.step'+n+'.text') %></p></div><% }) %>
    </div>
  </div>
</section>
<%- include('partials/cta') %>
<%- include('partials/footer') %>
