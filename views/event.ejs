<%- include('partials/header') %>
<% const d = parseDate(ev.date); %>
<section class="page-hero">
  <div class="wrap">
    <div class="hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/events">Events</a><span>/</span><%= ev.title %></nav>
      <% if (ev.category) { %><span class="badge" style="margin-bottom:18px"><%= ev.category %></span><% } %>
      <h1 data-split><%= ev.title %></h1>
      <div class="meta-row" style="color:#cfe2ea;font-size:1.05rem;gap:12px 26px">
        <span><svg><use href="#i-calendar"/></svg><%= fmtDate(ev.date, 'dow') %> <%= d ? d.getUTCFullYear() : '' %></span>
        <% if (ev.start_time) { %><span><svg><use href="#i-clock"/></svg><%= fmtTime(ev.start_time) %><%= ev.end_time ? ' – ' + fmtTime(ev.end_time) : '' %></span><% } %>
        <% if (ev.location) { %><span><svg><use href="#i-pin"/></svg><%= ev.location %></span><% } %>
      </div>
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap room-layout" style="margin-top:0">
    <div>
      <% if (ev.image) { %><div class="media" data-reveal="mask" style="margin-bottom:40px"><div class="ph" style="aspect-ratio:16/9"><%- img(ev.image, ev.title) %></div></div><% } %>
      <% if (ev.sample) { %><p><span class="badge grey">Sample event</span></p><% } %>
      <p class="lead" data-reveal><%= ev.summary %></p>
      <div class="rich" data-reveal><%- rich(ev.description) %></div>
    </div>
    <aside class="form-card" id="register" data-reveal="right" style="position:sticky;top:100px">
      <% if (ev.capacity) { %>
        <div class="spaces" data-reveal style="margin-bottom:22px"><span style="font-size:1.4rem;color:var(--navy)"><%= ev.full ? 'Fully booked' : ev.spacesLeft + ' spaces left' %></span><span class="muted" style="display:block;font-weight:500"><%= ev.taken %> of <%= ev.capacity %> places taken</span><div class="bar" style="width:100%;height:10px"><i style="--p:<%= Math.min(ev.taken / ev.capacity, 1) %>"></i></div></div>
      <% } %>
      <% if (status === 'ok') { %>
        <div class="success" style="padding:10px 0"><div class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><h3>You're booked in!</h3><p class="muted">We've saved your place. See you on <%= fmtDate(ev.date, 'dow') %>.</p></div>
      <% } else if (past) { %>
        <h3>This event has finished</h3><p class="muted">Take a look at our upcoming events.</p><a class="btn block" href="/events">Upcoming events</a>
      <% } else if (ev.full || status === 'full') { %>
        <h3>This event is fully booked</h3><p class="muted">All spaces have been taken. Message us to join the waiting list.</p><a class="btn wa block" href="<%= wa('Hi, please add me to the waiting list for ' + ev.title + ' on ' + fmtDate(ev.date)) %>" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>Join waiting list</a>
      <% } else if (ev.registration_open === false) { %>
        <h3>Registration not open online</h3><p class="muted">Speak to your key worker or message us to book.</p><a class="btn wa block" href="<%= wa('Hi, I would like to book ' + ev.title) %>" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>Message us</a>
      <% } else { %>
        <h3>Reserve your place</h3>
        <% if (status === 'duplicate') { %><div class="notice info"><svg><use href="#i-check"/></svg><div><p>You're already registered for this event.</p></div></div><% } %>
        <% if (status === 'invalid') { %><div class="notice danger"><svg><use href="#i-alert"/></svg><div><p>Please add your name, a phone number or email, and tick the box.</p></div></div><% } %>
        <form method="post" action="/events/<%= ev.slug %>/register" style="display:grid;gap:14px">
          <label class="hp">Leave empty <input name="website" tabindex="-1" autocomplete="off"></label>
          <div class="field"><label>Your name <em>*</em></label><input name="name" required autocomplete="name"></div>
          <div class="field"><label>Phone <em>*</em></label><input type="tel" name="phone" required autocomplete="tel"></div>
          <div class="field"><label>Email (for confirmation)</label><input type="email" name="email" autocomplete="email"></div>
          <div class="field"><label>Access or dietary needs</label><textarea name="notes" style="min-height:80px"></textarea></div>
          <label class="check-line"><input type="checkbox" name="consent" value="1" required> I'm happy for Solace Housing to contact me about this event.</label>
          <button class="btn block" type="submit">Book my place <svg class="arrow"><use href="#i-arrow"/></svg></button>
        </form>
      <% } %>
    </aside>
  </div>
</section>
<%- include('partials/footer') %>
