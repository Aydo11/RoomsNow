<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'referrals', crumb: 'Referrals', actions: '<a class="btn" href="#download"><svg><use href="#i-download"/></svg>Download referral form</a><a class="btn white" href="#submit">Submit a referral</a>' }) %>
<section class="section">
  <div class="wrap split" style="align-items:start">
    <div data-reveal="left"><span class="eyebrow">Eligibility</span><h2><%- cms('referrals.who.title') %></h2><%- cmsRich('referrals.who.text', 'rich') %></div>
    <div data-reveal="right">
      <span class="eyebrow">Process</span><h2><%- cms('referrals.steps.title') %></h2>
      <div class="timeline" data-timeline style="margin-top:30px">
        <% [1,2,3,4].forEach(function(n){ %><div class="tl-item" data-reveal><span class="dot"><%= n %></span><div class="box"><p style="color:var(--ink)"><%- cms('referrals.step'+n) %></p></div></div><% }) %>
      </div>
    </div>
  </div>
</section>
<section class="section bg-cream" id="download">
  <div class="wrap">
    <div class="sec-head"><div data-reveal><span class="eyebrow">Downloads</span><h2>Referral documents</h2><p class="lead">Always download the latest version. We update these forms from time to time.</p></div></div>
    <% if (documents.length) { %><%- include('partials/docs', { documents }) %><% } else { %><p class="muted">The referral form will be available here shortly. In the meantime, please contact us.</p><% } %>
    <div class="notice info" style="margin-top:30px" data-reveal><svg><use href="#i-shield"/></svg><div><h4>Consent</h4><p><%- cms('referrals.note') %></p></div></div>
  </div>
</section>
<section class="section" id="submit">
  <div class="wrap" style="max-width:900px">
    <div class="center" data-reveal style="margin-bottom:40px"><span class="eyebrow">Secure upload</span><h2>Send us a completed referral</h2><p class="lead">Upload the completed form and any supporting documents. It goes straight to our referrals team.</p></div>
    <div class="form-card" data-reveal>
      <% if (sent) { %>
        <div class="success"><div class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><h2>Referral received</h2><p class="lead" style="margin:0 auto">Thank you. We aim to respond within one working day.</p><span class="refno">Reference #<%= sent %></span></div>
      <% } else { %>
      <% if (query.error) { %><div class="notice danger"><svg><use href="#i-alert"/></svg><div><h4>Please check the form</h4><p>Your name, email and at least one attached file are required.</p></div></div><% } %>
      <form method="post" action="/referrals" enctype="multipart/form-data" class="fgrid">
        <label class="hp">Leave empty <input name="website" tabindex="-1" autocomplete="off"></label>
        <div class="field"><label>Your name <em>*</em></label><input name="referrer_name" required autocomplete="name"></div>
        <div class="field"><label>Organisation</label><input name="organisation" autocomplete="organization"></div>
        <div class="field"><label>Email <em>*</em></label><input type="email" name="referrer_email" required autocomplete="email"></div>
        <div class="field"><label>Phone</label><input type="tel" name="referrer_phone" autocomplete="tel"></div>
        <div class="field"><label>Applicant initials</label><input name="applicant" maxlength="10"><div class="hint">Initials only here. Full details go in the form.</div></div>
        <div class="field"><label>Urgency</label><select name="urgency"><option>Standard</option><option>Urgent (within 7 days)</option><option>Emergency (within 48 hours)</option></select></div>
        <div class="field full"><label>Completed referral form & supporting documents <em>*</em></label>
          <div class="drop" data-drop><svg><use href="#i-upload"/></svg><b>Drop files here or click to browse</b><span class="muted" style="font-size:.85rem">PDF, Word or photos · up to 5 files, 12MB each</span><input type="file" name="files" multiple required accept=".pdf,.doc,.docx,.odt,.rtf,image/*"></div><div class="previews" data-previews></div></div>
        <div class="field full"><label>Anything else we should know?</label><textarea name="notes"></textarea></div>
        <div class="full"><button class="btn" type="submit">Send referral <svg class="arrow"><use href="#i-arrow"/></svg></button></div>
      </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
