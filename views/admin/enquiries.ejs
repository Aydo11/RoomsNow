<%- include('_head', { title: 'WhatsApp enquiries' }) %>
<% const max = Math.max(1, ...byRoom.map(r => r.n), ...bySource.map(r => r.n)); %>
<div class="topbar"><div><h1>WhatsApp enquiries</h1><p>Every click on a WhatsApp button is counted here, by room and by where the person came from (website, Facebook, Google and so on). The WhatsApp message itself includes the room reference, so staff know which room it's about.</p></div>
<div class="filters" style="margin:0"><% [7,30,90,365].forEach(function(d){ %><a href="?days=<%= d %>" class="<%= days === d ? 'on' : '' %>"><%= d === 365 ? '1 year' : d + ' days' %></a><% }) %></div></div>
<div class="two">
<div class="card"><h2>By room</h2>
<% if (!byRoom.length) { %><div class="empty">No enquiries in this period.</div><% } byRoom.forEach(function(r){ %>
<div style="padding:8px 0"><div style="display:flex;justify-content:space-between"><span><b><%= r.room ? r.room.ref : (r.ref || 'General enquiry (no room)') %></b> <span class="muted"><%= r.room ? r.room.title : '' %></span></span><b><%= r.n %></b></div><div style="background:#F1ECE9;border-radius:8px;height:8px;margin-top:4px"><div class="bar-h" style="width:<%= r.n / max * 100 %>%"></div></div></div>
<% }) %></div>
<div class="card"><h2>By source</h2>
<% bySource.forEach(function(r){ %><div style="padding:8px 0"><div style="display:flex;justify-content:space-between"><span style="text-transform:capitalize"><%= r.source %></span><b><%= r.n %></b></div><div style="background:#F1ECE9;border-radius:8px;height:8px;margin-top:4px"><div class="bar-h" style="width:<%= r.n / max * 100 %>%;background:var(--navy)"></div></div></div><% }) %>
<% if (!bySource.length) { %><div class="empty">No data yet.</div><% } %></div>
</div>
<div class="card"><h2>Links for Facebook & other adverts</h2><p class="muted" style="margin-top:0">Paste the room link into your Facebook advert or post. It opens the room page, and the WhatsApp button on it is tracked as "facebook". Change <code>src=facebook</code> to <code>src=google</code>, <code>src=gumtree</code> or anything else for other sites.</p>
<div class="table-wrap"><table class="t"><thead><tr><th>Room</th><th>Room page link</th><th>Straight to WhatsApp</th></tr></thead><tbody>
<% rooms.forEach(function(r){ %><tr><td><b><%= r.ref %></b><div class="muted" style="font-size:.8rem"><%= r.title %></div></td><td style="min-width:240px"><div class="copy"><input readonly value="/r/<%= r.ref %>?src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div></td><td style="min-width:240px"><div class="copy"><input readonly value="/wa?room=<%= r.id %>&src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div></td></tr><% }) %>
<tr><td><b>General</b><div class="muted" style="font-size:.8rem">Any room enquiry</div></td><td><div class="copy"><input readonly value="/rooms?src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div></td><td><div class="copy"><input readonly value="/wa?src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div></td></tr>
</tbody></table></div></div>
<div class="card"><h2>Recent clicks</h2><div class="table-wrap"><table class="t"><thead><tr><th>When (UTC)</th><th>Room</th><th>Source</th><th>Page</th></tr></thead><tbody>
<% recent.forEach(function(c){ %><tr><td><%= c.created_at %></td><td><%= c.ref || '—' %></td><td><%= c.source %></td><td class="muted"><%= c.page %></td></tr><% }) %></tbody></table></div></div>
<%- include('_foot') %>
