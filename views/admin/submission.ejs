<%- include('_head', { title: 'Message #' + s.id }) %>
<div class="topbar"><div><div class="crumb"><a href="/admin/inbox">Inbox</a> /</div><h1><%= LABELS[s.type] || s.type %> #<%= s.id %></h1><p><%= s.subject %> · received <%= s.created_at %> UTC <%= s.emailed ? '· emailed ✓' : '· not emailed' %></p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap"><% if (s.phone) { %><a class="btn wa" href="https://wa.me/<%= s.phone.replace(/\D/g,'').replace(/^0/,'44') %>" target="_blank"><svg><use href="#i-whatsapp"/></svg>WhatsApp</a><a class="btn ghost" href="tel:<%= s.phone %>">Call</a><% } %><% if (s.email) { %><a class="btn ghost" href="mailto:<%= s.email %>?subject=<%= encodeURIComponent('Re: ' + (s.subject || 'your message') + ' (ref #' + s.id + ')') %>">Reply by email</a><% } %><button class="btn ghost" onclick="print()">Print</button></div></div>
<div class="edit-layout">
<div>
<div class="card"><table class="kv"><% Object.entries(data).forEach(function([k, v]){ if (v) { %><tr><th><%= k %></th><td><%= v %></td></tr><% } }) %></table></div>
<% if (files.length) { %><div class="card"><h2>Attachments</h2><div class="files"><% files.forEach(function(f){ const isImg = /\.(jpe?g|png|webp|gif|heic)$/i.test(f.src); %><a href="<%= f.src %>" target="_blank"><% if (isImg) { %><img src="<%= f.src %>" alt=""><% } else { %><span class="doc"><%= f.src.split('.').pop().toUpperCase() %></span><% } %><%= f.name %></a><% }) %></div></div><% } %>
</div>
<div class="sticky"><form class="card" method="post" style="display:grid;gap:12px">
<div class="f"><label class="l">Status</label><select name="status"><option value="open" <%= s.status !== 'closed' ? 'selected' : '' %>>In progress</option><option value="closed" <%= s.status === 'closed' ? 'selected' : '' %>>Resolved</option><option value="new">Mark as unread</option></select></div>
<div class="f"><label class="l">Internal notes</label><textarea name="note" placeholder="Only staff can see this, e.g. contractor booked for Tuesday"><%= s.note || '' %></textarea></div>
<button class="btn" name="action" value="save">Save</button>
<button class="btn ghost" name="action" value="resend" formnovalidate>Email this to the inbox again</button>
<button class="btn danger" name="action" value="delete" data-confirm="Delete this message and its attachments permanently?">Delete</button>
</form></div>
</div>
<%- include('_foot') %>
