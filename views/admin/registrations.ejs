<%- include('_head', { title: 'Registrations' }) %>
<% const cap = Number(ev.capacity) || 0; %>
<div class="topbar"><div><div class="crumb"><a href="/admin/c/events">Events</a> /</div><h1><%= ev.title %></h1><p><%= fmtDate(ev.date, 'dow') %> <%= ev.start_time ? '· ' + fmtTime(ev.start_time) : '' %> <%= ev.location ? '· ' + ev.location : '' %></p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn ghost" href="/admin/events/<%= ev.id %>/registrations.csv"><svg><use href="#i-download"/></svg>Download list (CSV)</a><a class="btn ghost" href="/admin/c/events/<%= ev.id %>">Edit event</a><button class="btn ghost" type="button" onclick="print()">Print</button></div></div>
<div class="stats">
  <div class="stat"><b><%= confirmed %></b><span>confirmed bookings</span></div>
  <div class="stat"><b><%= cap ? Math.max(cap - confirmed, 0) : '∞' %></b><span>spaces left<%= cap ? ' of ' + cap : '' %></span></div>
  <div class="stat"><b><%= cap && confirmed >= cap ? 'Full' : 'Open' %></b><span>booking status on the website</span></div>
</div>
<div class="two">
<div class="card"><h2>Registrations</h2>
<% if (!regs.length) { %><div class="empty">No one has registered yet.</div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>Name</th><th>Contact</th><th>Notes</th><th>Status</th><th></th></tr></thead><tbody>
<% regs.forEach(function(r){ %><tr style="<%= r.status === 'cancelled' ? 'opacity:.5' : '' %>"><td><b><%= r.name %></b><div class="muted" style="font-size:.78rem"><%= r.created_at %></div></td><td><%= r.phone %><br><span class="muted"><%= r.email %></span></td><td style="max-width:220px"><%= r.notes %></td>
<td><span class="badge <%= r.status === 'confirmed' ? 'green' : r.status === 'attended' ? 'navy' : '' %>"><%= r.status %></span></td>
<td><div class="acts">
<% if (r.status === 'confirmed') { %><form method="post" action="/admin/registrations/<%= r.id %>/attended"><button class="btn sm ghost">Attended</button></form><form method="post" action="/admin/registrations/<%= r.id %>/cancel"><button class="btn sm ghost">Cancel</button></form><% } else { %><form method="post" action="/admin/registrations/<%= r.id %>/restore"><button class="btn sm ghost">Restore</button></form><% } %>
<form method="post" action="/admin/registrations/<%= r.id %>/delete" data-confirm="Delete this registration?"><button class="btn sm danger">Delete</button></form></div></td></tr><% }) %>
</tbody></table></div><% } %></div>
<div class="card"><h2>Add a booking manually</h2><p class="muted" style="margin-top:0;font-size:.88rem">For people who book by phone, WhatsApp or in person.</p>
<form method="post" action="/admin/events/<%= ev.id %>/registrations" style="display:grid;gap:10px">
<div class="f"><label class="l">Name</label><input type="text" name="name" required></div>
<div class="f"><label class="l">Phone</label><input type="text" name="phone"></div>
<div class="f"><label class="l">Email</label><input type="email" name="email"></div>
<div class="f"><label class="l">Notes</label><input type="text" name="notes"></div>
<button class="btn">Add booking</button></form></div>
</div>
<%- include('_foot') %>
