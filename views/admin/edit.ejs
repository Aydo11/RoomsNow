<%- include('_head', { title: (isNew ? 'New ' : 'Edit ') + c.singular.toLowerCase() }) %>
<div class="topbar"><div><div class="crumb"><a href="/admin/c/<%= cid %>"><%= c.label %></a> /</div><h1><%= isNew ? 'New ' + c.singular.toLowerCase() : (item[c.titleField] || 'Edit') %></h1></div>
<% if (!isNew && ['rooms','events','stories','news'].includes(cid)) { %><a class="btn ghost" href="/<%= cid %>/<%= item.slug %>" target="_blank"><svg><use href="#i-arrow"/></svg>View on website</a><% } %></div>
<% if (c.help) { %><div class="help"><%= c.help %></div><% } %>
<form method="post" action="/admin/c/<%= cid %><%= isNew ? '' : '/' + item.id %>" enctype="multipart/form-data" class="edit-layout" data-dirty>
  <div class="card"><div class="form-grid">
    <% c.fields.forEach(function(f){ %><%- include('_field', { f, item }) %><% }) %>
  </div></div>
  <div class="sticky">
    <div class="card savebar">
      <label class="f"><span class="chk"><input type="checkbox" name="published" <%= item.published ? 'checked' : '' %>> Show on website</span></label>
      <% if (item.sample) { %><label class="f"><span class="chk"><input type="checkbox" name="clear_sample"> Remove "Sample" label</span></label><% } %>
      <button class="btn" type="submit" style="justify-content:center"><svg><use href="#i-check"/></svg>Save</button>
      <button class="btn ghost" type="submit" name="after" value="list" style="justify-content:center">Save & back to list</button>
      <% if (!isNew) { %><div class="muted" style="font-size:.78rem">Last updated <%= item.updated_at %> UTC</div><% } %>
    </div>
    <% if (!isNew && cid === 'rooms') { %>
    <div class="card"><h3>Share this room</h3><p class="muted" style="font-size:.85rem;margin-top:0">Use these in Facebook adverts and posts. Enquiries are tracked by room.</p>
      <label class="l" style="font-size:.8rem;font-weight:600">Facebook advert link</label><div class="copy"><input readonly value="/r/<%= item.ref %>?src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div>
      <label class="l" style="font-size:.8rem;font-weight:600;margin-top:10px;display:block">Direct WhatsApp link</label><div class="copy"><input readonly value="/wa?room=<%= item.id %>&src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div>
    </div><% } %>
    <% if (!isNew && cid === 'events') { %><div class="card"><a class="btn navy" style="width:100%;justify-content:center" href="/admin/events/<%= item.id %>/registrations"><svg><use href="#i-users"/></svg>View registrations</a></div><% } %>
    <% if (!isNew) { %>
    <div class="card" style="display:flex;flex-direction:column;gap:8px">
      <button class="btn ghost" formaction="/admin/c/<%= cid %>/<%= item.id %>/duplicate" formnovalidate style="justify-content:center">Duplicate</button>
      <button class="btn danger" formaction="/admin/c/<%= cid %>/<%= item.id %>/delete" formnovalidate data-confirm="Delete this <%= c.singular.toLowerCase() %> permanently?" style="justify-content:center">Delete</button>
    </div><% } %>
  </div>
</form>
<%- include('_foot') %>
