<% const v = item[f.name]; const id = 'f_' + f.name; %>
<div class="f f-<%= f.type %>">
  <% if (f.type !== 'checkbox') { %><label class="l" for="<%= id %>"><%= f.label %><%- f.required ? ' <em>*</em>' : '' %></label><% } %>
  <% if (f.type === 'text' || f.type === 'url') { %><input type="<%= f.type === 'url' ? 'url' : 'text' %>" id="<%= id %>" name="<%= f.name %>" value="<%= v || '' %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>>
  <% } else if (f.type === 'number') { %><input type="number" min="0" id="<%= id %>" name="<%= f.name %>" value="<%= v === 0 || v ? v : '' %>">
  <% } else if (f.type === 'date' || f.type === 'time') { %><input type="<%= f.type %>" id="<%= id %>" name="<%= f.name %>" value="<%= v || '' %>" <%= f.required ? 'required' : '' %>>
  <% } else if (f.type === 'select') { %><select id="<%= id %>" name="<%= f.name %>"><% f.options.forEach(function(o){ %><option <%= o === v ? 'selected' : '' %>><%= o %></option><% }) %></select>
  <% } else if (f.type === 'checkbox') { %><label class="chk"><input type="checkbox" name="<%= f.name %>" <%= v ? 'checked' : '' %>> <span><%= f.label %></span></label>
  <% } else if (f.type === 'textarea') { %><textarea id="<%= id %>" name="<%= f.name %>" rows="3"><%= v || '' %></textarea>
  <% } else if (f.type === 'rich') { %><textarea id="<%= id %>" name="<%= f.name %>"><%= v || '' %></textarea><div class="fmt">Leave a blank line between paragraphs. Start a line with <code>- </code> for a bullet list. <code>**bold**</code> for bold. <code>[link text](https://...)</code> for links.</div>
  <% } else if (f.type === 'list') { %><textarea id="<%= id %>" name="<%= f.name %>" rows="5"><%= (v || []).join('\n') %></textarea>
  <% } else if (f.type === 'image' || f.type === 'images') { const arr = f.type === 'image' ? (parseImg(v) ? [parseImg(v)] : []) : (v || []).map(parseImg).filter(Boolean); %>
    <div class="imgfield" data-imgfield data-multi="<%= f.type === 'images' ? 1 : 0 %>">
      <input type="hidden" name="<%= f.name %>__json" value="<%= JSON.stringify(f.type === 'image' ? (arr[0] || null) : arr) %>" data-json>
      <div class="imgs" data-list></div>
      <label class="adder" data-adder style="margin-top:<%= arr.length ? '12px' : '0' %>"><svg><use href="#i-upload"/></svg><span><%= f.type === 'images' ? 'Add photos' : (arr.length ? 'Replace image' : 'Upload image') %></span><small class="muted" style="font-weight:400">or drag & drop</small><input type="file" name="<%= f.name %>__new" accept="image/*" <%= f.type === 'images' ? 'multiple' : '' %>></label>
    </div>
  <% } else if (f.type === 'file') { const fo = v && v.src ? v : null; %>
    <div data-filefield><input type="hidden" name="<%= f.name %>__json" value="<%= JSON.stringify(fo) %>" data-json>
      <div class="filebox"><svg><use href="#i-file"/></svg><div style="flex:1;min-width:0"><% if (fo) { %><div class="nm" data-name><%= fo.name %></div><a href="<%= fo.src %>" target="_blank" style="font-size:.82rem">Open current file</a><% } else { %><div class="nm muted" data-name>No file uploaded</div><% } %></div>
        <label class="btn sm navy" style="position:relative;overflow:hidden"><%= fo ? 'Replace file' : 'Choose file' %><input type="file" name="<%= f.name %>__new" style="position:absolute;inset:0;opacity:0;cursor:pointer" data-fileinput></label></div></div>
  <% } %>
  <% if (f.help) { %><div class="hint"><%= f.help %></div><% } %>
</div>
