<%- include('_head', { title: 'Inbox' }) %>
<div class="topbar"><div><h1>Inbox</h1><p>Everything sent through the website's forms: repairs, referrals, complaints and messages. Nothing is lost, even if email isn't set up.</p></div></div>
<div class="filters">
  <a href="/admin/inbox" class="<%= !type && !status ? 'on' : '' %>">All</a>
  <a href="/admin/inbox?status=new" class="<%= status === 'new' ? 'on' : '' %>">Unread</a>
  <% ['repair','referral','contact','complaint'].forEach(function(t){ %><a href="/admin/inbox?type=<%= t %>" class="<%= type === t ? 'on' : '' %>"><%= LABELS[t] %>s<% if (counts[t]) { %><small><%= counts[t] %></small><% } %></a><% }) %>
  <a href="/admin/inbox?status=closed" class="<%= status === 'closed' ? 'on' : '' %>">Resolved</a>
</div>
<div class="card" style="padding:8px 10px">
<% if (!rows.length) { %><div class="empty"><svg><use href="#i-mail"/></svg><p>No messages here.</p></div><% } else { %>
<div class="table-wrap"><table class="t"><thead><tr><th>Ref</th><th>Subject</th><th>Type</th><th class="hide-sm">From</th><th>Received</th><th>Status</th></tr></thead><tbody>
<% rows.forEach(function(s){ const files = JSON.parse(s.files); %><tr class="<%= s.status === 'new' ? 'new' : '' %>">
<td class="muted">#<%= s.id %></td><td><a class="ttl" href="/admin/inbox/<%= s.id %>"><%= s.subject || '(no subject)' %></a><%= files.length ? ' 📎' : '' %></td>
<td><span class="badge <%= s.type === 'repair' ? 'pink' : s.type === 'referral' ? 'navy' : s.type === 'complaint' ? 'amber' : '' %>"><%= LABELS[s.type] || s.type %></span></td>
<td class="hide-sm"><%= s.name %><br><span class="muted" style="font-size:.8rem"><%= s.phone || s.email %></span></td>
<td style="white-space:nowrap"><%= s.created_at.slice(0,16).replace('T',' ') %></td>
<td><span class="badge <%= s.status === 'new' ? 'pink' : s.status === 'closed' ? 'green' : 'amber' %>"><%= s.status === 'open' ? 'In progress' : s.status === 'closed' ? 'Resolved' : 'New' %></span></td></tr><% }) %>
</tbody></table></div><% } %>
</div>
<%- include('_foot') %>
