<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Solace Admin</title>
<link rel="icon" href="/img/favicon.svg"><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css?v=1"></head><body>
<%- include('../partials/icons') %>
<div class="mobile-top"><a class="brand" href="/admin" style="padding:0"><span class="lg">solace</span></a><button type="button" data-side>Menu</button></div>
<div class="layout">
<aside class="side" id="side">
  <a class="brand" href="/admin"><span class="lg">solace</span><span>Admin</span></a>
  <% const p = path; const nl = (href, label, ic, extra) => { const on = href === '/admin' ? (p === '/admin' || p === '/admin/') : (p.startsWith(href) || (href === '/admin/c/events' && p.startsWith('/admin/events'))); return `<a class="nl ${on ? 'on' : ''}" href="${href}"><svg><use href="#i-${ic}"/></svg>${label}${extra || ''}</a>`; }; %>
  <%- nl('/admin', 'Dashboard', 'home') %>
  <%- nl('/admin/inbox', 'Inbox', 'mail', newCount ? `<span class="pill">${newCount}</span>` : '') %>
  <div class="grp">Website content</div>
  <%- nl('/admin/c/rooms', 'Rooms', 'bed') %>
  <%- nl('/admin/c/events', 'Events & bookings', 'calendar') %>
  <%- nl('/admin/c/stories', "Tenants' stories", 'star') %>
  <%- nl('/admin/c/news', 'News & newsletters', 'book') %>
  <%- nl('/admin/c/services', 'Services', 'heart') %>
  <%- nl('/admin/c/partners', 'Working together', 'users') %>
  <%- nl('/admin/c/documents', 'Documents', 'file') %>
  <%- nl('/admin/content', 'Page text & images', 'edit') %>
  <div class="grp">Insights</div>
  <%- nl('/admin/enquiries', 'WhatsApp enquiries', 'whatsapp') %>
  <%- nl('/admin/subscribers', 'Newsletter list', 'mail') %>
  <div class="grp">Setup</div>
  <%- nl('/admin/settings', 'Settings', 'compass') %>
  <%- nl('/admin/users', 'Staff logins', 'lock') %>
  <%- nl('/admin/help', 'Help guide', 'chat') %>
  <div class="foot"><a class="nl" href="/" target="_blank"><svg><use href="#i-arrow"/></svg>View website</a><a class="nl" href="/admin/logout"><svg><use href="#i-close"/></svg>Log out (<%= user.name %>)</a></div>
</aside>
<main class="main">
<% if (flash) { %><div class="flash <%= flash.type %>"><svg style="width:18px;height:18px"><use href="#i-<%= flash.type === 'ok' ? 'check' : 'alert' %>"/></svg><%= flash.msg %></div><% } %>
