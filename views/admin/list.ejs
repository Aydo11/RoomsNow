<%- include('_head', { title: c.label }) %>
<% const sortable = ['services','partners','documents','rooms'].includes(cid); %>
<div class="topbar"><div><h1><%= c.label %></h1><p><%= c.help %></p></div><a class="btn" href="/admin/c/<%= cid %>/new"><svg><use href="#i-arrow"/></svg>Add <%= c.singular.toLowerCase() %></a></div>
<div class="card" style="padding:8px 10px">
<% if (!items.length) { %><div class="empty"><svg><use href="#i-file"/></svg><p>Nothing here yet.</p><a class="btn" href="/admin/c/<%= cid %>/new">Add the first <%= c.singular.toLowerCase() %></a></div><% } else { %>
<div class="table-wrap"><table class="t" <%- sortable ? `data-sortable="/admin/c/${cid}/reorder"` : '' %>>
<thead><tr><% if (sortable) { %><th></th><% } %><th></th><th><%= c.singular %></th>
<% if (cid === 'rooms') { %><th>Status</th><th class="hide-sm">Area</th><th class="hide-sm">Enquiries</th><th class="hide-sm">Share links</th><% } %>
<% if (cid === 'events') { %><th>Date</th><th>Bookings</th><% } %>
<% if (cid === 'stories') { %><th>Date</th><th>Consent</th><% } %>
<% if (cid === 'news') { %><th>Date</th><th>Type</th><% } %>
<% if (cid === 'partners' || cid === 'documents') { %><th>Section</th><% } %>
<th>On website</th><th></th></tr></thead>
<tbody>
<% items.forEach(function(it){ const title = it[c.titleField] || 'Untitled'; const thumb = parseImg(it.image) || parseImg(it.logo) || parseImg((it.images || [])[0]); %>
<tr data-id="<%= it.id %>">
  <% if (sortable) { %><td class="handle" draggable="true" title="Drag to reorder"><svg><use href="#i-menu"/></svg></td><% } %>
  <td style="width:76px"><% if (thumb) { %><img class="th" src="<%= thumb.src %>" alt="" style="<%= pos(thumb) %>"><% } else { %><div class="th" style="width:64px;height:48px;display:grid;place-items:center;background:var(--cream);border-radius:0 8px 0 8px"><svg style="width:20px;height:20px;color:var(--pink)"><use href="#i-<%= cid === 'documents' ? 'file' : 'image' %>"/></svg></div><% } %></td>
  <td style="min-width:230px"><a class="ttl" href="/admin/c/<%= cid %>/<%= it.id %>"><%= title %></a><% if (it.sample) { %> <span class="badge amber">Sample</span><% } %>
    <div class="muted" style="font-size:.8rem"><%= cid === 'rooms' ? [it.ref, it.room_type].filter(Boolean).join(' · ') : cid === 'events' ? [it.start_time && fmtTime(it.start_time), it.location].filter(Boolean).join(' · ') : cid === 'documents' ? (it.file ? it.file.name : 'No file') : (it.summary || '').slice(0, 80) %></div></td>
  <% if (cid === 'rooms') { %>
    <td><form method="post" action="/admin/c/rooms/<%= it.id %>/status"><select class="status" name="status" data-v="<%= it.status %>" data-autosubmit><% COLLECTIONS.rooms.fields.find(f => f.name === 'status').options.forEach(function(o){ %><option <%= o === it.status ? 'selected' : '' %>><%= o %></option><% }) %></select></form></td>
    <td class="hide-sm"><%= it.area %></td>
    <td class="hide-sm"><b><%= clicks[it.id] || 0 %></b> <span class="muted" style="font-size:.8rem">WhatsApp</span></td>
    <td class="hide-sm" style="min-width:210px"><div class="copy"><input readonly value="/r/<%= it.ref %>?src=facebook" data-abs><button class="btn sm ghost" type="button" data-copy>Copy</button></div><div class="muted" style="font-size:.72rem;margin-top:3px">Link for Facebook adverts</div></td>
  <% } %>
  <% if (cid === 'events') { %><td style="white-space:nowrap"><%= fmtDate(it.date, 'short') %><% if (it.date < today()) { %> <span class="badge">Past</span><% } %></td><td><a href="/admin/events/<%= it.id %>/registrations" class="btn sm ghost"><%= it.taken %><%= it.capacity ? ' / ' + it.capacity : '' %> booked</a></td><% } %>
  <% if (cid === 'stories') { %><td style="white-space:nowrap"><%= fmtDate(it.date, 'short') %></td><td><%- it.consent ? '<span class="badge green">Confirmed</span>' : '<span class="badge pink">Missing</span>' %></td><% } %>
  <% if (cid === 'news') { %><td style="white-space:nowrap"><%= fmtDate(it.date, 'short') %></td><td><span class="badge"><%= it.category %></span></td><% } %>
  <% if (cid === 'partners') { %><td><span class="badge"><%= it.category %></span></td><% } %>
  <% if (cid === 'documents') { %><td><span class="badge"><%= it.section %></span></td><% } %>
  <td><form method="post" action="/admin/c/<%= cid %>/<%= it.id %>/toggle"><button class="toggle <%= it.published ? 'on' : '' %>" title="<%= it.published ? 'Showing, click to hide' : 'Hidden, click to show' %>" aria-label="Toggle visibility"></button></form></td>
  <td><div class="acts"><a class="btn sm ghost" href="/admin/c/<%= cid %>/<%= it.id %>">Edit</a>
    <% if (['rooms','events','stories','news'].includes(cid)) { %><a class="btn sm ghost" href="/<%= cid %>/<%= it.slug %>" target="_blank">View</a><% } %></div></td>
</tr>
<% }) %>
</tbody></table></div>
<% } %>
</div>
<% if (sortable && items.length > 1) { %><p class="muted" style="font-size:.85rem">Tip: drag the <svg style="width:14px;height:14px;vertical-align:middle"><use href="#i-menu"/></svg> handle to change the order shown on the website.</p><% } %>
<%- include('_foot') %>
