<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'complaints', crumb: 'Complaints', actions: '<a class="btn" href="#form">Make a complaint <svg class="arrow"><use href="#i-arrow"/></svg></a><a class="btn white" href="#process">How it works</a>' }) %>
<section class="section">
  <div class="wrap split" style="align-items:start">
    <div data-reveal="left" style="position:sticky;top:110px"><span class="eyebrow">Step one</span><h2><%- cms('complaints.how.title') %></h2><%- cmsRich('complaints.how.text', 'rich lead') %>
      <div class="actions" style="margin-top:26px"><a class="btn wa" href="<%= wa('Hi, I would like to make a complaint.') %>" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>WhatsApp</a><a class="btn ghost" href="<%= telHref %>"><svg><use href="#i-phone"/></svg><%= settings.phone %></a></div></div>
    <div id="process">
      <span class="eyebrow" data-reveal>The lifecycle of a complaint</span>
      <div class="timeline" data-timeline style="margin-top:20px">
        <% const when = ['Within 2 working days','Ongoing','Throughout','Within 10 working days','Within 20 working days','Final outcome']; [1,2,3,4,5,6].forEach(function(n){ %>
        <div class="tl-item" data-reveal><span class="dot"><%= n %></span><div class="box"><span class="when"><%= when[n-1] %></span><h3><%- cms('complaints.s'+n+'.title') %></h3><p><%- cms('complaints.s'+n+'.text') %></p></div></div>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<section class="section bg-cream">
  <div class="wrap split" style="align-items:start">
    <div data-reveal="left"><span class="eyebrow">Escalation</span><h2><%- cms('complaints.escalate.title') %></h2><%- cmsRich('complaints.escalate.text', 'rich lead') %>
      <% if (documents.length) { %><div style="margin-top:30px"><% documents.forEach(function(d){ %><a class="doc" href="<%= d.file.src %>" download="<%= d.file.name %>" style="margin-bottom:12px"><span class="ic"><svg><use href="#i-file"/></svg></span><div><h4><%= d.title %></h4><p><%= d.description %></p></div><span class="dl"><svg><use href="#i-download"/></svg></span></a><% }) %></div><% } %>
    </div>
    <div class="form-card" id="form" data-reveal="right">
      <% if (sent) { %>
        <div class="success"><div class="tick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><h2>Complaint received</h2><p class="lead" style="margin:0 auto 12px">Thank you for telling us. We will acknowledge your complaint within 2 working days.</p><span class="refno">Reference #<%= sent %></span></div>
      <% } else { %>
      <h3>Make a complaint online</h3>
      <% if (query.error) { %><div class="notice danger"><svg><use href="#i-alert"/></svg><div><p>Please add your name, a way to contact you and what happened.</p></div></div><% } %>
      <form method="post" action="/complaints" class="fgrid">
        <label class="hp">Leave empty <input name="website" tabindex="-1" autocomplete="off"></label>
        <div class="field"><label>Your name <em>*</em></label><input name="name" required autocomplete="name"></div>
        <div class="field"><label>I am</label><select name="relationship"><option>A tenant</option><option>Complaining for a tenant</option><option>A referral agency / professional</option><option>A neighbour / member of the public</option><option>Other</option></select></div>
        <div class="field"><label>Phone</label><input type="tel" name="phone" autocomplete="tel"></div>
        <div class="field"><label>Email</label><input type="email" name="email" autocomplete="email"></div>
        <div class="field full"><label>How should we contact you?</label><select name="preferred"><option>Phone</option><option>WhatsApp</option><option>Email</option><option>In person</option></select></div>
        <div class="field full"><label>What happened? <em>*</em></label><textarea name="details" required></textarea></div>
        <div class="field full"><label>What would put things right?</label><textarea name="outcome" style="min-height:90px"></textarea></div>
        <div class="full"><button class="btn" type="submit">Send complaint <svg class="arrow"><use href="#i-arrow"/></svg></button></div>
      </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
