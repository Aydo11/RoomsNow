<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'events', crumb: 'Events calendar' }) %>
<section class="section" style="padding-top:60px">
  <div class="wrap">
    <div class="tabs" role="tablist" data-reveal>
      <button class="<%= query.month ? '' : 'on' %>" data-tab="list" role="tab"><svg><use href="#i-list"/></svg>Upcoming</button>
      <button class="<%= query.month ? 'on' : '' %>" data-tab="cal" role="tab"><svg><use href="#i-calendar"/></svg>Calendar</button>
    </div>
    <div data-panel="list" <%= query.month ? 'hidden' : '' %>>
      <% if (upcoming.length) { %>
      <div class="grid g3"><% upcoming.forEach(function(ev, i){ %><%- include('partials/event-card', { ev, i }) %><% }) %></div>
      <% } else { %><div class="notice info"><svg><use href="#i-calendar"/></svg><div><p><%- cms('events.empty') %></p></div></div><% } %>
    </div>
    <div data-panel="cal" <%= query.month ? '' : 'hidden' %>>
      <div class="cal">
        <div class="cal-head"><a href="/events?month=<%= prev %>" aria-label="Previous month"><svg><use href="#i-left"/></svg></a><h3><%= monthLabel %></h3><a href="/events?month=<%= next %>" aria-label="Next month"><svg><use href="#i-right"/></svg></a></div>
        <div class="cal-grid">
          <% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function(d){ %><div class="dow"><%= d %></div><% }) %>
          <% cells.forEach(function(c){ if (!c) { %><div class="day" style="background:#FCFAF9"></div><% } else { %>
            <div class="day <%= c.iso === now ? 'today' : '' %> <%= c.iso < now ? 'past' : '' %>"><span class="d"><%= c.d %></span>
              <% c.events.forEach(function(e){ %><a class="cal-ev <%= e.full ? 'full' : '' %>" href="/events/<%= e.slug %>" title="<%= e.title %>"><%= e.start_time ? fmtTime(e.start_time) + ' · ' : '' %><%= e.title %><%= e.full ? ' (full)' : '' %></a><% }) %>
            </div>
          <% } }) %>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="section tight"><div class="wrap"><%- include('partials/newsletter') %></div></section>
<%- include('partials/footer') %>
