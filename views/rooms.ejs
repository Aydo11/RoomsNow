<%- include('partials/header') %>
<%- include('partials/page-hero', { key: 'rooms', crumb: 'Rooms available', actions: '<a class="btn wa" href="/wa?page=rooms' + (src ? '&src=' + encodeURIComponent(src) : '') + '" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>' + esc(t('global.wa.label')) + '</a><a class="btn white" href="/referrals">Referral agencies</a>' }) %>
<section class="section" style="padding-top:60px">
  <div class="wrap">
    <% if (rooms.length) { %>
    <div class="filters" data-reveal role="group" aria-label="Filter rooms">
      <button class="chip on" data-filter-status="">All rooms</button>
      <button class="chip" data-filter-status="Available now">Available now</button>
      <button class="chip" data-filter-status="Available soon">Coming soon</button>
      <% if (areas.length > 1) { %><select data-filter-area aria-label="Area"><option value="">All areas</option><% areas.forEach(function(a){ %><option><%= a %></option><% }) %></select><% } %>
      <% if (types.length > 1) { %><select data-filter-type aria-label="Room type"><option value="">All room types</option><% types.forEach(function(a){ %><option><%= a %></option><% }) %></select><% } %>
      <span class="count" data-count><%= rooms.length %> room<%= rooms.length === 1 ? '' : 's' %></span>
    </div>
    <div class="grid g3" data-rooms><% rooms.forEach(function(room, i){ %><%- include('partials/room-card', { room, i, src }) %><% }) %></div>
    <p class="muted center" data-none hidden style="padding:40px 0">No rooms match those filters. Try another option or message us on WhatsApp.</p>
    <% } else { %>
    <div class="form-card center" data-reveal style="max-width:720px;margin:0 auto"><div class="success"><div class="tick" style="background:var(--navy)"><svg><use href="#i-bed"/></svg></div><h2>No rooms right now</h2><p class="lead" style="margin:0 auto 26px"><%- cms('rooms.empty') %></p><a class="btn wa" href="/wa?page=rooms-empty" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg><%= t('global.wa.label') %></a></div></div>
    <% } %>
  </div>
</section>
<section class="section bg-cream">
  <div class="wrap">
    <h2 class="center" data-reveal style="margin-bottom:46px"><%- cms('rooms.how.title') %></h2>
    <div class="steps4"><% [1,2,3,4].forEach(function(n){ %><div data-reveal style="--i:<%= n-1 %>"><%- cms('rooms.how'+n) %></div><% }) %></div>
    <div class="center" style="margin-top:40px" data-reveal><a class="btn wa" href="/wa?page=rooms-how" target="_blank" rel="noopener"><svg><use href="#i-whatsapp"/></svg>Start on WhatsApp, no forms needed</a></div>
  </div>
</section>
<%- include('partials/footer') %>
