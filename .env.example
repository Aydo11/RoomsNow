# ---------- Core ----------
# Runtime connection. Add ?connection_limit=N&pool_timeout=20 if you're not
# already behind an external pooler — see the note in README under "Database".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportrooms?schema=public"
# Direct/unpooled connection for schema commands (migrate, db push). For a
# single local Postgres with nothing in front of it, this is the same URL.
# On Neon/Supabase/PgBouncer, point this at the *unpooled* connection string
# they give you and leave DATABASE_URL on the pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/supportrooms?schema=public"
# Must be at least 32 characters. Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32-characters-minimum"
APP_URL="http://localhost:3000"

# ---------- Error monitoring (Sentry) ----------
# Leave blank to disable — without it, errors just aren't reported anywhere.
# From Sentry: Settings > Projects > <project> > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=""

# ---------- Google sign-in ----------
# Google Cloud OAuth redirect URI: https://www.roomsnow.co.uk/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Storage (media uploads) ----------
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER="local"
# Private files (referral attachments, verification evidence) are written here,
# OUTSIDE the web root. Never point this inside ./public.
PRIVATE_UPLOAD_DIR=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
# Optional S3-compatible endpoint, for example Cloudflare R2. Leave blank for AWS S3.
S3_ENDPOINT=""
# Set true for providers that require path-style URLs (for example MinIO).
S3_FORCE_PATH_STYLE="false"

# ---------- Billing (provider-agnostic; Stripe adapter included) ----------
# BILLING_DRIVER=mock | stripe
BILLING_DRIVER="mock"
# Never enable mock billing in production unless this is a private test environment.
ALLOW_MOCK_BILLING="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PROFESSIONAL=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_FEATURED_LISTING=""
STRIPE_PRICE_BOOST_1=""
STRIPE_PRICE_BOOST_3=""
STRIPE_PRICE_BOOST_10=""
STRIPE_PRICE_REFERRER_PRO=""
# Stripe webhook URL: https://your-domain.example/api/billing/webhook

# ---------- Email / SMS (adapters stubbed in src/lib/notify.ts) ----------
# EMAIL_DRIVER=console | resend | ses
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"
# SMS_DRIVER=console | twilio
SMS_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---------- Maps / geocoding ----------
# The map works out of the box: OpenStreetMap tiles and postcodes.io geocoding,
# neither of which needs an account. Swap the tile URL for a paid provider when
# traffic justifies it.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
# GEOCODE_DRIVER=postcodes | none
GEOCODE_DRIVER="postcodes"

# ---------- Security ----------
# RATE_LIMIT_DRIVER=memory | upstash
# memory works on a single instance; use Upstash behind a load balancer.
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to false if the app is exposed directly rather than behind a proxy you
# control, so a spoofed X-Forwarded-For can't be used to dodge rate limits.
TRUST_PROXY="true"

# ---------- Optional error monitoring (rebuild after changing public DSN) ----------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Secret token used only to upload source maps during the build.
SENTRY_AUTH_TOKEN=""
