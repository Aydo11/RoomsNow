// RoomsNow — UK housing and accommodation marketplace
// Relational schema. PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — point this at a pooler (PgBouncer, Neon's pooled
  // endpoint, Supabase's "Transaction" mode) in production. Poolers in
  // transaction mode don't support prepared statements, which is fine for
  // normal queries but breaks schema commands, hence directUrl below.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection used only by `prisma migrate` / `prisma db
  // push` for schema changes. For a single local Postgres with no pooler in
  // front of it, this can be identical to DATABASE_URL — see .env.example.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  USER // person looking for accommodation
  PROVIDER // company / advertiser staff member
  REFERRER // professional making referrals
  SERVICE_PROVIDER // trade / support business advertising to accommodation providers
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContactMethod {
  MESSAGE
  EMAIL
  PHONE
}

enum OrgType {
  SUPPORTED_ACCOMMODATION_PROVIDER
  HOUSING_PROVIDER
  MANAGING_AGENT
  LANDLORD
  CHARITY
  COMMUNITY_ORGANISATION
  OTHER
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum AccommodationType {
  SINGLE_ROOM
  SHARED_ACCOMMODATION
  SELF_CONTAINED
  FLAT
  HOUSE
  OTHER
}

enum GenderArrangement {
  ANY
  FEMALE_ONLY
  MALE_ONLY
  MIXED
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  VOID
  MAINTENANCE
  UNAVAILABLE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum ReferralRoute {
  SELF_REFERRAL
  PROFESSIONAL_REFERRAL
  LOCAL_AUTHORITY
  ANY
}

enum MediaType {
  IMAGE
  VIDEO
  VIDEO_URL
  DOCUMENT
}

enum RequestStatus {
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  ASSESSMENT
  OFFERED
  ACCEPTED
  MOVED_IN
  DECLINED
  WITHDRAWN
}

enum ReferralStatus {
  SUBMITTED
  RECEIVED
  UNDER_REVIEW
  ASSESSMENT
  OFFERED
  ACCEPTED
  MOVED_IN
  DECLINED
  WITHDRAWN
}

/// Basis the professional referrer says their organisation relies on to share
/// personal data for this referral. This is an audit declaration, not a legal
/// determination by RoomsNow and not a substitute for the referrer's records.
enum ReferralDataBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  VITAL_INTERESTS
  PUBLIC_TASK
  LEGITIMATE_INTERESTS
  RECOGNISED_LEGITIMATE_INTERESTS
  OTHER
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MembershipTier {
  FREE
  PROFESSIONAL
  BUSINESS
  // Referrer-facing plans. Kept in the same enum as the provider tiers so
  // Subscription-style logic (planLimits, billing driver) stays one shape —
  // MembershipAudience is what actually separates the two catalogues.
  REFERRER_FREE
  REFERRER_PRO
}

/// Which side of the marketplace a Membership row is for. A provider plan and
/// a referrer plan never compete for the same tier or the same pricing table.
enum MembershipAudience {
  PROVIDER
  REFERRER
}

enum ClientStatus {
  ACTIVE // currently being supported / looking for a placement
  PLACED // successfully housed
  ARCHIVED // no longer being supported by this referrer
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentKind {
  SUBSCRIPTION
  FEATURED_LISTING
  BOOST
  BOOST_PACK
  OTHER
}

enum VerificationType {
  COMPANY
  PROPERTY
}

enum VerificationStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum AccreditationStatus {
  UNDER_ASSESSMENT
  APPROVED
  REJECTED
  EXPIRED
}

enum ReportReason {
  SCAM
  INCORRECT_INFORMATION
  UNSAFE_ACCOMMODATION
  INAPPROPRIATE_CONTENT
  MISLEADING_INFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum ReportTargetType {
  LISTING
  USER
  COMPANY
  MESSAGE
  LOOKING_FOR_AD
  SERVICE_BUSINESS
  SERVICE_ADVERT
}

enum NotificationType {
  MESSAGE
  REQUEST
  REFERRAL
  LISTING
  SAVED_LISTING
  MEMBERSHIP
  VERIFICATION
  REVIEW
  SYSTEM
}

enum AlertFrequency {
  INSTANT
  DAILY
  OFF
}

/// How a user first heard about RoomsNow, captured at registration (from a
/// `?src=` link on outbound campaigns, or self-selected in the sign-up form).
/// Nullable/unset for anyone who registered before this was added.
enum AcquisitionSource {
  SOCIAL_MEDIA
  EMAIL
  SEARCH_ENGINE
  REFERRAL
  WORD_OF_MOUTH
  PRESS
  OTHER
}

// ---------------------------------------------------------------- identity

model User {
  id                        String             @id @default(cuid())
  email                     String             @unique
  passwordHash              String
  role                      Role               @default(USER)
  adminPermissions          String[]           @default(["ALL"])
  status                    AccountStatus      @default(ACTIVE)
  firstName                 String
  lastName                  String
  phone                     String?
  locationLabel             String?
  contactMethod             ContactMethod      @default(MESSAGE)
  /// Account-level profile picture. Used by roles (REFERRER) that don't have
  /// their own profile record with a photo field.
  avatarUrl                 String?
  /// Referrer-only: organisation and role, captured at registration.
  organisation              String?
  jobTitle                  String?
  /// Array of { platform, url }. Shown on the account's own profile pages.
  socialLinks               Json?
  emailVerified             DateTime?
  emailVerificationRequired Boolean            @default(false)
  lastLoginAt               DateTime?
  /// Bumped on password change, logout-everywhere and suspension. Any session
  /// token issued before the current value is rejected, so a stolen cookie stops
  /// working the moment the account owner reacts.
  tokenVersion              Int                @default(0)
  passwordChangedAt         DateTime?
  deletedAt                 DateTime?
  retainUntil               DateTime?
  /// Marketing channel attribution, captured once at sign-up — see AcquisitionSource.
  acquisitionSource         AcquisitionSource?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  profile                  UserProfile?
  staffOf                  CompanyStaff[]
  lookingForAds            LookingForAd[]
  requests                 AccommodationRequest[]    @relation("RequestApplicant")
  referralsMade            Referral[]                @relation("ReferralReferrer")
  savedListings            SavedListing[]
  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
  councilAccess            CouncilAccess?
  placementCheckIns        PlacementCheckIn[]
  residentReviews          ResidentReview[]   @relation("ResidentReviewAuthor")
  messages                 Message[]
  participations           ConversationParticipant[]
  reportsFiled             Report[]                  @relation("ReportReporter")
  reportEvents             ReportEvent[]             @relation("ReportEventActor")
  documents                Document[]
  auditLogs                AuditLog[]
  blocksMade               Block[]                   @relation("Blocker")
  blocksReceived           Block[]                   @relation("Blocked")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  referrerSubscription     ReferrerSubscription?
  referrerPayments         ReferrerPayment[]
  clients                  Client[]                  @relation("ReferrerClients")
  clientSharesSent         ClientShare[]             @relation("ClientSharesSent")
  membershipGrantsMade     MembershipGrant[]         @relation("MembershipGrantAdmin")
  userMembershipGrants     UserMembershipGrant[]     @relation("UserMembershipGrantRecipient")
  userMembershipGrantsMade UserMembershipGrant[]     @relation("UserMembershipGrantAdmin")
  savedSearches            SavedSearch[]
  providerReviews          ProviderReview[]
  referrerProfile          ReferrerProfile?
  referralOrgMembership    ReferralOrgMember?
  referralOrgsOwned        ReferralOrganisation[]    @relation("ReferralOrgOwner")
  referralInvitesSent      ReferralOrgInvite[]       @relation("ReferralInviteSender")
  serviceBusiness          ServiceBusiness?          @relation("ServiceBusinessOwner")
  serviceQuotes            ServiceQuoteRequest[]     @relation("ServiceQuoteRequester")
  serviceFavourites        ServiceFavourite[]
  serviceReviews           ServiceReview[]           @relation("ServiceReviewAuthor")

  @@index([role, status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model UserProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl           String?
  about              String?
  accommodationNeeds String?
  supportNeeds       String?
  preferredLocations String[]            @default([])
  preferredTypes     AccommodationType[] @default([])
  genderArrangement  GenderArrangement   @default(ANY)
  dateOfBirth        DateTime?
  availableFrom      DateTime?
  accessibilityNeeds String?
  otherRequirements  String?
  supportTypes       String[]            @default([])
  publicProfile      Boolean             @default(false)
  showPhoto          Boolean             @default(false)
  showAge            Boolean             @default(true)
  showLocation       Boolean             @default(true)
  discoverable       Boolean             @default(false)
  /// Array of { platform, url }. Shown on the public profile when publicProfile is on.
  socialLinks        Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ---------------------------------------------------------------- provider side

model Company {
  id                     String             @id @default(cuid())
  name                   String
  tradingName            String?
  slug                   String             @unique
  registrationNumber     String?
  email                  String
  phone                  String?
  website                String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  postcode               String?
  operatingAreas         String[]           @default([])
  orgType                OrgType            @default(SUPPORTED_ACCOMMODATION_PROVIDER)
  about                  String?
  logoUrl                String?
  bannerUrl              String?
  /// Array of { platform, url }. Shown on the public company profile page.
  socialLinks            Json?
  supportTypes           String[]           @default([])
  verification           VerificationStatus @default(NOT_REQUESTED)
  verifiedAt             DateTime?
  status                 AccountStatus      @default(ACTIVE)
  /// Purchased 24-hour boost credits. Membership allowances are calculated
  /// separately per billing period so paid packs never expire.
  boostCredits           Int                @default(0)
  /// Stable invite code for the provider-to-provider referral programme.
  /// Generated lazily the first time it's needed — see ensureReferralCode —
  /// so existing companies never need a backfill migration.
  referralCode           String?            @unique
  /// How many 5-qualified-referral reward cycles this company has already
  /// been paid out for. Prevents re-granting the same milestone twice.
  referralRewardsClaimed Int                @default(0)
  /// Free 30-day sponsored placements earned by inviting other providers (one
  /// per invited provider who posts their first advert). Spent one at a time
  /// on any live advert from the advert's Sponsor panel.
  freeSponsorMonths      Int                @default(0)
  /// Median minutes to first reply to a new conversation, over the last 90
  /// days. Recalculated hourly by lib/response-time.ts; null until there's
  /// enough history. Drives the "Usually replies within…" badge.
  responseMinutes        Int?
  /// How many conversations responseMinutes is based on.
  responseSampleSize     Int                @default(0)
  /// Weekly performance summary email (lib/weekly-summary.ts). On by default;
  /// providers can turn it off in their company settings.
  weeklySummary          Boolean            @default(true)
  weeklySummarySentAt    DateTime?
  /// Total advert views when the last summary went out, so the next one can
  /// report views for that week alone.
  weeklySummaryViews     Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  staff            CompanyStaff[]
  properties       Property[]
  listings         Listing[]
  subscription     Subscription?
  payments         Payment[]
  verifications    VerificationRequest[]
  documents        Document[]
  clientShares     ClientShare[]
  membershipGrants MembershipGrant[]
  reviews          ProviderReview[]
  accreditations   ProviderAccreditation[]
  referralsMade    ProviderReferral[]      @relation("ReferralsMade")
  referredVia      ProviderReferral?       @relation("ReferralsReceived")
  quickReplies     QuickReply[]
  residentReviews  ResidentReview[]
  serviceQuotes    ServiceQuoteRequest[]

  @@index([city])
}

/// A saved message a provider's team can drop into a conversation in one tap.
model QuickReply {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model ProviderAccreditation {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheme          String
  name            String
  rating          String?
  referenceNumber String?
  publicUrl       String?
  status          AccreditationStatus @default(UNDER_ASSESSMENT)
  submittedBy     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  documents       Document[]

  @@index([companyId, status])
  @@index([status, createdAt])
}

model CompanyStaff {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffRole StaffRole @default(STAFF)
  createdAt DateTime  @default(now())

  @@unique([companyId, userId])
}

model Property {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  addressLine1     String?
  addressLine2     String?
  city             String
  area             String?
  postcode         String
  showExactAddress Boolean            @default(false)
  latitude         Float?
  longitude        Float?
  propertyType     AccommodationType  @default(SHARED_ACCOMMODATION)
  bedrooms         Int                @default(1)
  verification     VerificationStatus @default(NOT_REQUESTED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  rooms    Room[]
  listings Listing[]

  @@index([city])
  @@index([latitude, longitude])
}

model Room {
  id            String         @id @default(cuid())
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  status        RoomStatus     @default(AVAILABLE)
  monthlyRent   Int?
  weeklyRent    Int?
  ensuite       Boolean        @default(false)
  furnished     Boolean        @default(true)
  sizeSqm       Float?
  availableFrom DateTime?
  /// When the room last became empty (AVAILABLE or VOID). Drives the void
  /// cost counter. Null on rooms empty since before tracking began, where
  /// updatedAt is used instead.
  vacantSince   DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  listingId     String?
  listing       Listing?       @relation(fields: [listingId], references: [id])
  media         ListingMedia[]

  @@index([propertyId, status])
  @@index([listingId, status])
}

model Listing {
  id          String        @id @default(cuid())
  reference   String        @unique
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  description String?
  status      ListingStatus @default(DRAFT)

  accommodationType  AccommodationType @default(SHARED_ACCOMMODATION)
  genderArrangement  GenderArrangement @default(ANY)
  minAge             Int?
  maxAge             Int?
  ensuite            Boolean           @default(false)
  furnished          Boolean           @default(true)
  selfContained      Boolean           @default(false)
  sharedFacilities   Boolean           @default(true)
  wheelchairAccess   Boolean           @default(false)
  accessibilityNotes String?
  petsAllowed        Boolean           @default(false)

  supportTypes        String[]        @default([])
  supportDescription  String?
  supportAvailability String?
  supportProvider     String?
  referralRoutes      ReferralRoute[] @default([])
  eligibility         String?
  referralProcess     String?
  houseRules          String?

  weeklyRentFrom Int?
  weeklyRentTo   Int?
  billsIncluded  Boolean   @default(true)
  housingBenefit Boolean   @default(true)
  availableFrom  DateTime?

  /// Set by the system when it pauses an advert on the provider's behalf —
  /// "NO_AVAILABILITY" (every room stopped being lettable) or "STALE" (a
  /// "still available?" nudge went unanswered). Null when live, or when a
  /// person paused it themselves. Read by syncListingAvailability and
  /// runListingFreshnessCheck (src/lib/listing-availability.ts) to
  /// auto-reactivate once the reason clears, and shown to the provider so an
  /// auto-pause never looks like a mystery.
  pausedReason            String?
  /// Bumped whenever a provider confirms the advert is accurate — creating
  /// or editing it, changing a room's status, or answering a staleness
  /// nudge. Drives runListingFreshnessCheck.
  availabilityConfirmedAt DateTime  @default(now())
  /// Set when the "still available?" nudge email goes out, so it's sent at
  /// most once per staleness window rather than every time the hourly check
  /// runs.
  staleNudgeSentAt        DateTime?

  /// Sponsored placement. Sponsored adverts are pinned to the first page of a
  /// matching search, ordered by bid, and are always labelled as sponsored.
  featured             Boolean   @default(false)
  featuredUntil        DateTime?
  sponsoredBid         Int       @default(0)
  sponsoredImpressions Int       @default(0)
  sponsoredClicks      Int       @default(0)
  /// A boost is a separate, short promotion. The first three hours receive
  /// newest-boost priority; after that active boosts rotate fairly.
  boostStartsAt        DateTime?
  boostPriorityUntil   DateTime?
  boostedUntil         DateTime?
  boostedImpressions   Int       @default(0)
  boostedClicks        Int       @default(0)
  views                Int       @default(0)
  enquiries            Int       @default(0)
  publishedAt          DateTime?
  rejectionNote        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  rooms         Room[]
  media         ListingMedia[]
  saves         SavedListing[]
  requests      AccommodationRequest[]
  referrals     Referral[]
  shortlistedBy ShortlistItem[]
  residentReviews ResidentReview[]
  conversations Conversation[]
  applications  Application[]
  viewings      Viewing[]

  @@index([status, featured, featuredUntil])
  @@index([status, boostedUntil, boostStartsAt])
  @@index([status, publishedAt])
  @@index([status, weeklyRentFrom])
  @@index([status, availableFrom, publishedAt])
  @@index([status, accommodationType, publishedAt])
  @@index([status, availabilityConfirmedAt])
  @@index([companyId, status, updatedAt])
  @@index([companyId])
}

model ListingMedia {
  id         String    @id @default(cuid())
  listingId  String
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type       MediaType @default(IMAGE)
  url        String
  storageKey String?
  caption    String?
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  position   Int       @default(0)
  isPrimary  Boolean   @default(false)
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime  @default(now())

  @@index([listingId, position])
  @@index([roomId, position])
}

// ---------------------------------------------------------------- seeker side

model LookingForAd {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  city               String
  postcode           String?
  radiusMiles        Int                 @default(10)
  accommodationTypes AccommodationType[] @default([])
  supportTypes       String[]            @default([])
  moveInDate         DateTime?
  budgetWeekly       Int?
  genderArrangement  GenderArrangement   @default(ANY)
  age                Int?
  accessibilityNeeds String?
  about              String?
  lookingFor         String?
  photoUrl           String?
  videoUrl           String?
  status             ListingStatus       @default(ACTIVE)
  views              Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  conversations Conversation[]

  @@index([city, status])
}

model AccommodationRequest {
  id                 String        @id @default(cuid())
  listingId          String
  listing            Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicantId        String
  applicant          User          @relation("RequestApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  moveInDate         DateTime?
  accommodationNeeds String?
  supportNeeds       String?
  additionalInfo     String?
  status             RequestStatus @default(SUBMITTED)
  statusNote         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  /// Set when a provider archives this request from their queue. Purely a
  /// view filter — never changes status or notifies the applicant.
  archivedAt         DateTime?

  application Application?
  documents   Document[]
  viewings    Viewing[]

  @@unique([listingId, applicantId])
  @@index([status])
  @@index([applicantId, status])
}

model Referral {
  id         String   @id @default(cuid())
  reference  String   @unique
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id])
  referrerId String
  referrer   User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  /// Optional link to a saved Client record the referral was made from. Kept
  /// on SetNull so deleting a client record never deletes referral history —
  /// the referral is the provider-facing paper trail and outlives the client
  /// record.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  applicantFirstName String
  applicantLastName  String
  applicantDob       DateTime?
  applicantPhone     String?
  applicantEmail     String?
  applicantUserId    String?

  organisation                      String?
  referrerJobTitle                  String?
  preferredLocation                 String?
  accommodationNeeds                String?
  supportNeeds                      String?
  supportTypes                      String[]           @default([])
  urgency                           Urgency            @default(MEDIUM)
  additionalInfo                    String?
  dataSharingBasis                  ReferralDataBasis?
  dataSharingConfirmedAt            DateTime?
  specialCategoryConditionConfirmed Boolean            @default(false)
  privacyNoticeVersion              String?
  status                            ReferralStatus     @default(SUBMITTED)
  statusNote                        String?
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt

  application Application?
  documents   Document[]
  events      ReferralEvent[]
  viewings    Viewing[]
  review      ProviderReview?
  checkIns    PlacementCheckIn[]
  /// When the 4-week and 12-week "how is the placement going?" prompts went out.
  checkIn4SentAt  DateTime?
  checkIn12SentAt DateTime?

  @@index([status])
  @@index([clientId])
  @@index([referrerId, status])
  @@index([listingId, createdAt])
  @@index([createdAt])
  @@index([applicantEmail])
}

/// A referrer's rating of how a specific placement went, left once a referral
/// reaches MOVED_IN. Tied 1:1 to the referral it came from (not freely
/// postable) so a review always maps to a real, verified placement — this is
/// what tells a future referrer whether the service was actually good,
/// alongside (not instead of) the due-diligence checks in VerificationPanel.
model ProviderReview {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referralId String   @unique
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}

enum ProviderReferralStatus {
  SIGNED_UP // registered a new provider account using this invite code
  QUALIFIED // went on to submit their first advert for review
}

/// One row per new provider account that registered using another provider's
/// invite code. Stays SIGNED_UP until the new company submits its first
/// advert, at which point qualifyProviderReferral() flips it to QUALIFIED
/// and checks whether the referrer has just earned another reward.
model ProviderReferral {
  id                String                 @id @default(cuid())
  referrerCompanyId String
  referrerCompany   Company                @relation("ReferralsMade", fields: [referrerCompanyId], references: [id], onDelete: Cascade)
  referredCompanyId String                 @unique
  referredCompany   Company                @relation("ReferralsReceived", fields: [referredCompanyId], references: [id], onDelete: Cascade)
  status            ProviderReferralStatus @default(SIGNED_UP)
  qualifiedAt       DateTime?
  createdAt         DateTime               @default(now())

  @@index([referrerCompanyId, status])
}

/// A person a referrer is supporting — their "caseload" or "tenants". Exists
/// independently of a platform User account: most people being referred never
/// sign up themselves, so this is the referrer's own record, not a shared one.
model Client {
  id                 String       @id @default(cuid())
  referrerId         String
  referrer           User         @relation("ReferrerClients", fields: [referrerId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  preferredLocation  String?
  accommodationNeeds String?
  supportNeeds       String?
  supportTypes       String[]     @default([])
  riskNotes          String?
  status             ClientStatus @default(ACTIVE)
  /// Profile picture. Stored privately (a `private:` key) and only ever served
  /// through /api/clients/[id]/photo, which applies the same access rule as
  /// the record itself — these are often vulnerable people.
  photoUrl           String?
  /// Soft delete. A deleted client sits in the referrer's "Deleted" bin (and
  /// stops counting towards their plan) until restored or removed for good;
  /// every active share is revoked the moment it's deleted.
  deletedAt          DateTime?
  /// Optional structured needs and risk assessment (see src/lib/assessment.ts).
  /// Private to the referrer — used to rank adverts for this client, never
  /// shared with providers automatically.
  assessment         Json?
  assessedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  referrals Referral[]
  shortlist ShortlistItem[]
  shares    ClientShare[]
  messages  Message[]

  @@index([referrerId, status])
  @@index([referrerId, deletedAt])
}

/// A client profile shared with a specific provider — the "send profile"
/// feature. Sharing does not attach documents; it gives the provider read
/// access to the client record itself, revocable at any time. This is
/// deliberately a different, narrower thing than a Referral: a share is "here
/// is who I'm looking to place", a referral is "please assess this person for
/// your specific advert".
model ClientShare {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sharedById String
  sharedBy   User      @relation("ClientSharesSent", fields: [sharedById], references: [id], onDelete: Cascade)
  note       String?
  reviewStatus String?
  reviewNote String?
  reviewedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([clientId, companyId])
  @@index([companyId, revokedAt])
}

/// A referrer's public-facing agency profile — banner, logo, what they do and
/// where. The agency name lives on User.organisation (captured at sign-up) so
/// there is one source of truth for it across referrals and shares.
model ReferrerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyType   String?
  bannerUrl    String?
  logoUrl      String?
  about        String?
  website      String?
  publicEmail  String?
  publicPhone  String?
  areasCovered String[] @default([])
  specialisms  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReferralEvent {
  id         String         @id @default(cuid())
  referralId String
  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
  status     ReferralStatus
  note       String?
  actorId    String?
  createdAt  DateTime       @default(now())

  @@index([referralId, createdAt])
}

/// Provider-side pipeline record. A request or a referral becomes an application
/// once a provider starts working it, so both routes share one worklist.
model Application {
  id         String                @id @default(cuid())
  listingId  String
  listing    Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestId  String?               @unique
  request    AccommodationRequest? @relation(fields: [requestId], references: [id])
  referralId String?               @unique
  referral   Referral?             @relation(fields: [referralId], references: [id])
  roomId     String?
  stage      String                @default("new")
  assignedTo String?
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

enum ViewingStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A room viewing tied to the request or referral it came from. Providers
/// propose a time, then move it through confirmed/completed/no-show/cancelled
/// as the actual viewing plays out — giving them one place to see everything
/// they've got coming up, instead of tracking it by memory or a side
/// spreadsheet. Exactly one of requestId/referralId is set; listingId is
/// always derived server-side from whichever one it is (see
/// scheduleViewingAction), never taken on trust from the client.
model Viewing {
  id           String                @id @default(cuid())
  listingId    String
  listing      Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestId    String?
  request      AccommodationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  referralId   String?
  referral     Referral?             @relation(fields: [referralId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  note         String?
  status       ViewingStatus         @default(PROPOSED)
  /// Freeform reason set alongside a CANCELLED or NO_SHOW status.
  outcomeNote  String?
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([listingId])
  @@index([requestId])
  @@index([referralId])
  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------- messaging

model Conversation {
  id             String        @id @default(cuid())
  subject        String?
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])
  lookingForAdId String?
  lookingForAd   LookingForAd? @relation(fields: [lookingForAdId], references: [id])
  companyId      String?
  /// Set on External Services Marketplace conversations (the Services tab).
  serviceBusinessId String?
  serviceBusiness   ServiceBusiness? @relation(fields: [serviceBusinessId], references: [id], onDelete: Cascade)
  serviceAdvertId   String?
  serviceAdvert     ServiceAdvert?   @relation(fields: [serviceAdvertId], references: [id], onDelete: SetNull)
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@index([serviceBusinessId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String?
  lastReadAt     DateTime?
  archived       Boolean      @default(false)

  @@unique([conversationId, userId])
  @@index([userId, archived])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  /// A client profile a referrer dropped into the conversation. clientCard is
  /// a snapshot of the shareable fields (never riskNotes) taken at send time,
  /// so the card still reads correctly if the record is later edited or
  /// deleted; clientId links through to the live profile while it exists.
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientCard     Json?
  isPinned       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  pinnedAt       DateTime?
  pinnedById     String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ---------------------------------------------------------------- engagement

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  notify    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

/// A stored search filter a user wants to be alerted about. Mirrors the
/// public search filter shape (see SearchParams in src/server/search.ts) so
/// re-running it later — or matching a freshly published advert against it —
/// uses exactly the same criteria the person saw on screen.
model SavedSearch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Short label shown in "Your alerts", e.g. "Leeds · Mental health support".
  label  String

  where         String?
  radius        Int?
  support       String[]        @default([])
  type          String[]        @default([])
  gender        String?
  minAge        Int?
  wheelchair    Boolean         @default(false)
  furnished     Boolean         @default(false)
  ensuite       Boolean         @default(false)
  selfContained Boolean         @default(false)
  petsAllowed   Boolean         @default(false)
  /// "woman" or "man": skip homes only for the other (from the eligibility check).
  resident      String?
  /// Only homes that accept Housing Benefit.
  housingBenefit Boolean        @default(false)
  referral      ReferralRoute[] @default([])
  verifiedOnly  Boolean         @default(false)
  minRent       Int?
  maxRent       Int?

  frequency     AlertFrequency @default(INSTANT)
  /// Last time this search matched at least one advert and an alert went out.
  lastAlertedAt DateTime?
  /// Watermark for the daily digest job — only adverts published after this
  /// are considered "new" next time it runs.
  lastDigestAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([frequency])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// ---------------------------------------------------------------- commerce

/// Plan catalogue. Editable by admins; prices are placeholders until billing is live.
model Membership {
  id                 String             @id @default(cuid())
  tier               MembershipTier     @unique
  /// Provider plans gate listings/rooms/staff; referrer plans gate clients and
  /// profile shares. See `audience` below.
  audience           MembershipAudience @default(PROVIDER)
  name               String
  priceMonthly       Int
  priceYearly        Int?
  maxListings        Int
  maxRooms           Int
  maxStaff           Int
  maxPhotos          Int                @default(15)
  videoUploads       Boolean            @default(false)
  analytics          Boolean            @default(false)
  priorityPlacement  Boolean            @default(false)
  featuredCredits    Int                @default(0)
  /// Included 24-hour boosts available in each paid billing period.
  includedBoosts     Int                @default(0)
  enhancedProfile    Boolean            @default(false)
  prioritySupport    Boolean            @default(false)
  externalPriceId    String?
  description        String?
  active             Boolean            @default(true)
  /// Referrer-plan-only: how many active clients a referrer on this plan can
  /// hold at once. -1 is unlimited. Ignored for provider plans.
  maxClients         Int                @default(-1)
  /// Referrer-plan-only: how many provider organisations a referrer can share
  /// a client profile with at once, per client. -1 is unlimited.
  maxSharesPerClient Int                @default(-1)
  /// Referrer-plan-only: priority routing badge shown to providers on
  /// referrals from this plan, and priority ordering in provider inboxes.
  priorityRouting    Boolean            @default(false)

  subscriptions         Subscription[]
  referrerSubscriptions ReferrerSubscription[]
  adminGrants           MembershipGrant[]
  userAdminGrants       UserMembershipGrant[]
}

/// A complimentary provider plan granted by a full administrator. This is
/// deliberately separate from Subscription so a grant never alters Stripe
/// customer/subscription identifiers or creates a false payment record.
model MembershipGrant {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  grantedById  String
  grantedBy    User       @relation("MembershipGrantAdmin", fields: [grantedById], references: [id])
  reason       String
  startsAt     DateTime   @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([companyId, revokedAt, expiresAt])
  @@index([grantedById, createdAt])
}

/// Complimentary access granted to one referrer account. Kept separate from
/// ReferrerSubscription so an admin grant cannot alter Stripe billing records.
model UserMembershipGrant {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserMembershipGrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])
  grantedById  String
  grantedBy    User       @relation("UserMembershipGrantAdmin", fields: [grantedById], references: [id])
  reason       String
  startsAt     DateTime   @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@index([grantedById, createdAt])
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membershipId           String
  membership             Membership         @relation(fields: [membershipId], references: [id])
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments Payment[]
}

/// The referrer-side twin of Subscription. Kept as a separate model rather
/// than making Subscription.companyId optional: a referrer never has a
/// company, and this way every existing company-billing query keeps its
/// non-null guarantee instead of growing a null check everywhere.
model ReferrerSubscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId           String
  membership             Membership         @relation(fields: [membershipId], references: [id])
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments ReferrerPayment[]
}

model ReferrerPayment {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      ReferrerSubscription? @relation(fields: [subscriptionId], references: [id])
  kind              PaymentKind           @default(SUBSCRIPTION)
  amount            Int
  currency          String                @default("GBP")
  status            PaymentStatus         @default(PENDING)
  description       String?
  externalPaymentId String?               @unique
  invoiceUrl        String?
  createdAt         DateTime              @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  kind              PaymentKind   @default(SUBSCRIPTION)
  amount            Int
  currency          String        @default("GBP")
  status            PaymentStatus @default(PENDING)
  description       String?
  externalPaymentId String?       @unique
  invoiceUrl        String?
  /// Present for boost activations so included allowance use can be counted
  /// independently from non-expiring purchased credits.
  boostSource       String?
  boostListingId    String?
  createdAt         DateTime      @default(now())

  @@index([companyId, kind, boostSource, createdAt])
}

// ---------------------------------------------------------------- trust & safety

model VerificationRequest {
  id                      String             @id @default(cuid())
  type                    VerificationType   @default(COMPANY)
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId              String?
  status                  VerificationStatus @default(PENDING)
  submittedBy             String?
  reviewedBy              String?
  reviewedAt              DateTime?
  note                    String?
  reviewNote              String?
  insuranceExpiresAt      DateTime?
  /// Set once a "your insurance is expiring" reminder has gone out for this
  /// approved verification, so the hourly check (see
  /// runInsuranceExpiryCheck) never re-sends it. Cleared implicitly by a
  /// fresh submission, since that creates a brand-new row.
  insuranceReminderSentAt DateTime?
  declarationAcceptedAt   DateTime?
  checklistVersion        String             @default("2026-09")
  registrationChecked     Boolean            @default(false)
  insuranceChecked        Boolean            @default(false)
  governanceChecked       Boolean            @default(false)
  safeguardingChecked     Boolean            @default(false)
  identityChecked         Boolean            @default(false)
  createdAt               DateTime           @default(now())

  documents Document[]

  @@index([status])
  @@index([companyId])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  detail     String?
  status     ReportStatus     @default(OPEN)
  resolution String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt
  archivedAt DateTime?
  events     ReportEvent[]

  @@index([status])
  @@index([archivedAt, createdAt])
}

model ReportEvent {
  id        String       @id @default(cuid())
  reportId  String
  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?        @relation("ReportEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  status    ReportStatus
  note      String?
  createdAt DateTime     @default(now())

  @@index([reportId, createdAt])
}

model Document {
  id                    String                 @id @default(cuid())
  ownerId               String?
  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  companyId             String?
  company               Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  referralId            String?
  referral              Referral?              @relation(fields: [referralId], references: [id], onDelete: Cascade)
  requestId             String?
  request               AccommodationRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verificationRequestId String?
  verificationRequest   VerificationRequest?   @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  accreditationId       String?
  accreditation         ProviderAccreditation? @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  name                  String
  category              String?
  url                   String
  mimeType              String?
  sizeBytes             Int?
  isPrivate             Boolean                @default(true)
  createdAt             DateTime               @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Admin-managed taxonomy so support categories are data, not hard-coded strings.
model SupportType {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String
  position Int     @default(0)
  active   Boolean @default(true)
}

model LocationArea {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  region    String?
  latitude  Float?
  longitude Float?
  active    Boolean @default(true)
}

enum ReferralOrgRole {
  OWNER
  ADMIN
  MEMBER
}

/// A referral agency with several colleagues. Each colleague keeps their own
/// login and personal profile; the organisation shares one caseload, one
/// agency profile (the owner's ReferrerProfile) and the owner's plan.
model ReferralOrganisation {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("ReferralOrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ReferralOrgMember[]
  invites ReferralOrgInvite[]

  @@index([ownerId])
}

model ReferralOrgMember {
  id             String               @id @default(cuid())
  organisationId String
  organisation   ReferralOrganisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  /// A person belongs to at most one referral organisation.
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ReferralOrgRole      @default(MEMBER)
  createdAt      DateTime             @default(now())

  @@index([organisationId])
}

model ReferralOrgInvite {
  id             String               @id @default(cuid())
  organisationId String
  organisation   ReferralOrganisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  role           ReferralOrgRole      @default(MEMBER)
  /// SHA-256 of the one-use token in the invitation link.
  tokenHash      String               @unique
  invitedById    String
  invitedBy      User                 @relation("ReferralInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())

  @@index([organisationId, acceptedAt])
  @@index([email])
}

/// A phone or browser that asked for push notifications. One user can have
/// several (their phone and their laptop). Removed when the push service says
/// the subscription has gone.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// "Tell me when a room comes up" for people without an account. Nothing is
/// sent until the address is confirmed from the first message.
model RoomAlert {
  id            String    @id @default(cuid())
  email         String?
  phone         String?
  where         String
  support       String[]  @default([])
  /// Random token used in the confirm and stop links.
  token         String    @unique
  confirmedAt   DateTime?
  lastAlertedAt DateTime?
  alertsSent    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([confirmedAt])
  @@index([email])
  @@index([phone])
}

/// A room a referrer has shortlisted for one client (3 to 5 usually), for
/// comparing side by side and printing a referral pack.
model ShortlistItem {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  note      String?
  addedById String?
  createdAt DateTime @default(now())

  @@unique([clientId, listingId])
}

enum PlacementHealth {
  GOING_WELL
  SOME_CONCERNS
  AT_RISK
  ENDED
}

/// Answer to the 4-week or 12-week "is the placement going well?" check-in,
/// from the referrer's side or the provider's side.
model PlacementCheckIn {
  id         String          @id @default(cuid())
  referralId String
  referral   Referral        @relation(fields: [referralId], references: [id], onDelete: Cascade)
  week       Int
  /// "REFERRER" or "PROVIDER"
  side       String
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  health     PlacementHealth
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([referralId, week, side])
  @@index([health])
}

/// Read-only council view for a local authority team. Granted by an admin.
/// `areas` are town or city names and postcode prefixes (e.g. "Birmingham", "B").
model CouncilAccess {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  councilName String
  areas       String[] @default([])
  grantedById String?
  createdAt   DateTime @default(now())
}

/// A review from someone who actually lived in the accommodation. Only
/// possible once their own request (or a referral made for them) reached
/// MOVED_IN, once per placement, so every review maps to a real stay. Shown
/// publicly as "Verified resident", never with the person's name.
model ResidentReview {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listingId        String?
  listing          Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  authorId         String
  author           User      @relation("ResidentReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  requestId        String?   @unique
  referralId       String?   @unique
  rating           Int
  feelSafe         Boolean?
  supportHelpful   Boolean?
  comment          String?
  stillLivingThere Boolean   @default(true)
  /// Set by an admin to take a review down (e.g. it names someone).
  hiddenAt         DateTime?
  hiddenReason     String?
  providerReply    String?
  providerReplyAt  DateTime?
  providerReplyBy  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, hiddenAt, createdAt])
  @@index([listingId])
}


// ------------------------------------------------ external services marketplace
//
// Trades and support businesses (cleaners, electricians, gas engineers, pest
// control, furniture, etc.) advertise to accommodation providers. Only paid
// accommodation providers see who they are and can contact them. A service
// business never gets access to accommodation clients, referrals or support
// records: it only ever sees the quote requests and conversations it is part of.

enum ServiceBusinessStatus {
  ONBOARDING
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum ServiceAdvertStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  REJECTED
  ARCHIVED
}

enum ServicePlanTier {
  STANDARD
  PRO
}

enum ServicePriceType {
  FIXED
  FROM
  RANGE
  HOURLY
  QUOTE
}

enum ServiceQuoteStatus {
  NEW
  VIEWED
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum ServiceUrgency {
  FLEXIBLE
  WITHIN_A_MONTH
  WITHIN_A_WEEK
  URGENT
  EMERGENCY
}

enum ServiceEvidenceType {
  PUBLIC_LIABILITY
  EMPLOYERS_LIABILITY
  INCORPORATION
  QUALIFICATION
  LICENCE
  ACCREDITATION
  OTHER
}

enum ServiceEvidenceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ServiceBusiness {
  id                 String                @id @default(cuid())
  ownerId            String                @unique
  owner              User                  @relation("ServiceBusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  tradingName        String?
  slug               String                @unique
  contactName        String
  email              String
  phone              String?
  website            String?
  /// Array of { platform, url }.
  socialLinks        Json?
  logoUrl            String?
  coverUrl           String?
  /// Companies House number. Shown publicly only as "Registered company".
  companyNumber      String?
  categories         String[]              @default([])
  /// Towns, cities or regions covered.
  areas              String[]              @default([])
  /// Outward postcodes covered, e.g. B21, WS1.
  postcodes          String[]              @default([])
  nationalCoverage   Boolean               @default(false)
  /// Base postcode and how far from it the business travels. The point is
  /// geocoded on save so radius searches never call out at query time.
  basePostcode       String?
  latitude           Float?
  longitude          Float?
  radiusMiles        Int?
  description        String?
  yearsExperience    Int?
  openingHours       String?
  emergencyAvailable Boolean               @default(false)
  pricingSummary     String?
  quoteOnly          Boolean               @default(true)
  terms              String?
  cancellationPolicy String?
  /// What the business promises, e.g. "Within 2 working hours".
  responseTarget     String?
  /// Median minutes to first reply to a quote request, recalculated on reply.
  responseMinutes    Int?
  /// Public portfolio image URLs.
  portfolio          String[]              @default([])
  status             ServiceBusinessStatus @default(ONBOARDING)
  statusReason       String?
  submittedAt        DateTime?
  verifiedAt         DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  profileViews       Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  evidence      ServiceEvidence[]
  adverts       ServiceAdvert[]
  subscription  ServiceSubscription?
  quotes        ServiceQuoteRequest[]
  reviews       ServiceReview[]
  boosts        ServiceBoost[]
  events        ServiceEvent[]
  conversations Conversation[]

  @@index([status])
}

/// Private due-diligence documents. Originals are only ever served to admins
/// with full permission, and every download is written to the audit log.
model ServiceEvidence {
  id           String                @id @default(cuid())
  businessId   String
  business     ServiceBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         ServiceEvidenceType
  /// Public-safe name, e.g. "Gas Safe Register" or "Public liability £5m".
  label        String
  issuer       String?
  /// Policy / registration / licence number. Never shown publicly.
  reference    String?
  expiresAt    DateTime?
  fileUrl      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  status       ServiceEvidenceStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  uploadedById String
  createdAt    DateTime              @default(now())

  @@index([businessId, status])
}

model ServiceSubscription {
  id                     String             @id @default(cuid())
  businessId             String             @unique
  business               ServiceBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tier                   ServicePlanTier
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?            @unique
  /// Boost credits (Pro includes 3 a month). Topped up once per period.
  boostCredits           Int                @default(0)
  creditsPeriod          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model ServiceAdvert {
  id             String              @id @default(cuid())
  businessId     String
  business       ServiceBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title          String
  category       String
  subcategory    String?
  description    String
  locations      String[]            @default([])
  nationwide     Boolean             @default(false)
  priceType      ServicePriceType    @default(QUOTE)
  /// Pence.
  priceFrom      Int?
  priceTo        Int?
  priceUnit      String?
  images         String[]            @default([])
  availability   String?
  emergency      Boolean             @default(false)
  sameDay        Boolean             @default(false)
  qualifications String?
  website        String?
  status         ServiceAdvertStatus @default(DRAFT)
  reviewNote     String?
  submittedAt    DateTime?
  publishedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  views          Int                 @default(0)
  enquiries      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  boosts        ServiceBoost[]
  quotes        ServiceQuoteRequest[]
  favourites    ServiceFavourite[]
  conversations Conversation[]

  @@index([status, category])
  @@index([businessId, status])
}

model ServiceBoost {
  id                String          @id @default(cuid())
  advertId          String
  advert            ServiceAdvert   @relation(fields: [advertId], references: [id], onDelete: Cascade)
  businessId        String
  business          ServiceBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  days              Int
  /// Pence paid; 0 when a plan credit or admin grant was used.
  amount            Int             @default(0)
  source            String
  externalPaymentId String?         @unique
  startsAt          DateTime
  endsAt            DateTime
  impressions       Int             @default(0)
  clicks            Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([advertId, endsAt])
  @@index([endsAt])
}

model ServiceQuoteRequest {
  id              String             @id @default(cuid())
  businessId      String
  business        ServiceBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  advertId        String?
  advert          ServiceAdvert?     @relation(fields: [advertId], references: [id], onDelete: SetNull)
  requesterId     String
  requester       User               @relation("ServiceQuoteRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId  String?
  service         String
  location        String
  preferredDate   DateTime?
  urgency         ServiceUrgency     @default(FLEXIBLE)
  description     String
  /// Pence.
  budgetMin       Int?
  budgetMax       Int?
  /// Array of { url, name, type, size } — private files.
  attachments     Json?
  status          ServiceQuoteStatus @default(NEW)
  quoteAmount     Int?
  quoteNote       String?
  quoteValidUntil DateTime?
  declineReason   String?
  viewedAt        DateTime?
  quotedAt        DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  review ServiceReview?

  @@index([businessId, status])
  @@index([companyId, status])
}

model ServiceFavourite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  advertId  String
  advert    ServiceAdvert @relation(fields: [advertId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, advertId])
}

model ServiceReview {
  id            String              @id @default(cuid())
  quoteId       String              @unique
  quote         ServiceQuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  businessId    String
  business      ServiceBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                @relation("ServiceReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  companyId     String
  rating        Int
  quality       Int
  communication Int
  timeliness    Int
  value         Int
  comment       String?
  hiddenAt      DateTime?
  hiddenReason  String?
  reply         String?
  replyAt       DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([businessId, hiddenAt])
}

/// Lightweight analytics. businessId is null for marketplace-wide search demand.
model ServiceEvent {
  id         String           @id @default(cuid())
  businessId String?
  business   ServiceBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  advertId   String?
  /// PROFILE_VIEW | ADVERT_VIEW | CONTACT | QUOTE | FAVOURITE | BOOST_IMPRESSION | BOOST_CLICK | SEARCH
  type       String
  category   String?
  location   String?
  createdAt  DateTime         @default(now())

  @@index([businessId, type, createdAt])
  @@index([type, createdAt])
}
